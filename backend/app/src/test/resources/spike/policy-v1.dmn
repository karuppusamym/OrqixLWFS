<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="dmn_spike-policy_v1" name="spike-policy"
             namespace="https://orqix.example/decisions">
  <decision id="spike-policy" name="spike-policy">
    <decisionTable id="spike-policy__table" hitPolicy="FIRST">
      <input id="spike-policy__in" label="/input/amount">
        <inputExpression id="spike-policy__inexpr" typeRef="number"><text>in1</text></inputExpression>
      </input>
      <output id="spike-policy__out_route" name="route" typeRef="string"/>
      <rule id="spike-policy__r1">
        <inputEntry id="spike-policy__r1_in"><text><![CDATA[>= 5000]]></text></inputEntry>
        <outputEntry id="spike-policy__r1_route"><text><![CDATA["financeReview"]]></text></outputEntry>
      </rule>
      <rule id="spike-policy__default">
        <inputEntry id="spike-policy__default_in"><text>-</text></inputEntry>
        <outputEntry id="spike-policy__default_route"><text><![CDATA["standard"]]></text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
