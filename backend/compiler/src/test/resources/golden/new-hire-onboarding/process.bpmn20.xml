<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" xmlns:orqix="https://orqix.example/bpmn/v0" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC" xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="https://orqix.example/workflows">
  <process id="new-hire-onboarding" name="New hire onboarding" isExecutable="true">
    <extensionElements>
      <orqix:release schemaVersion="0.1" compilerVersion="0.2.0" semanticHash="900d26d991fe8b3330895c82df52bf316b2f44d3472621b672ffecc2f739e189"/>
    </extensionElements>
    <startEvent id="start" name="New colleague submitted"/>
    <parallelGateway id="setup" name="Prepare in parallel"/>
    <userTask id="it" name="IT accounts and access" flowable:candidateGroups="it-desk">
      <extensionElements>
        <orqix:approval rejectReasonRequired="true" dueAfterHours="24" timeoutAfter="PT4H"/>
      </extensionElements>
    </userTask>
    <sequenceFlow id="it__out" sourceRef="it" targetRef="it__route"/>
    <exclusiveGateway id="it__route" name="IT accounts and access: outcome"/>
    <boundaryEvent id="it__timeout" name="IT accounts and access: no decision in time" attachedToRef="it" cancelActivity="true">
      <extensionElements>
        <orqix:timeout after="PT4H"/>
      </extensionElements>
      <timerEventDefinition>
        <timeDuration>PT4H</timeDuration>
      </timerEventDefinition>
    </boundaryEvent>
    <userTask id="itEscalation" name="IT lead review" flowable:candidateGroups="managers">
      <extensionElements>
        <orqix:approval rejectReasonRequired="true" dueAfterHours="24"/>
      </extensionElements>
    </userTask>
    <sequenceFlow id="itEscalation__out" sourceRef="itEscalation" targetRef="itEscalation__route"/>
    <exclusiveGateway id="itEscalation__route" name="IT lead review: outcome"/>
    <serviceTask id="itReady" name="Tell requester IT access is approved" flowable:delegateExpression="${orqixNotificationTask}">
      <extensionElements>
        <orqix:notification channel="inApp" recipient="initiator" message="IT accounts and access were approved."/>
      </extensionElements>
    </serviceTask>
    <userTask id="facilities" name="Desk and building pass" flowable:candidateGroups="facilities-team">
      <extensionElements>
        <orqix:approval rejectReasonRequired="true" dueAfterHours="48"/>
      </extensionElements>
    </userTask>
    <sequenceFlow id="facilities__out" sourceRef="facilities" targetRef="facilities__route"/>
    <exclusiveGateway id="facilities__route" name="Desk and building pass: outcome"/>
    <parallelGateway id="setupDone" name="IT and Facilities are done" flowable:async="true" flowable:exclusive="true"/>
    <intermediateCatchEvent id="leadTime" name="Allow lead time before ordering">
      <extensionElements>
        <orqix:wait duration="PT1M"/>
      </extensionElements>
      <timerEventDefinition>
        <timeDuration>PT1M</timeDuration>
      </timerEventDefinition>
    </intermediateCatchEvent>
    <serviceTask id="orderEquipment" name="Order equipment" flowable:async="true" flowable:exclusive="true" flowable:triggerable="true" flowable:delegateExpression="${orqixChildTask}">
      <extensionElements>
        <flowable:failedJobRetryTimeCycle>R3/PT30S</flowable:failedJobRetryTimeCycle>
        <orqix:child workflow="purchase-approval" releaseNumber="1" semanticHash="6ae448102e3af36408646948be6e02a899e806a03afd6e3eee595db579484c7f">
          <orqix:input name="amount" fieldRef="/input/equipmentBudget"/>
          <orqix:input name="costCenter" fieldRef="/input/department"/>
          <orqix:input name="purpose" fieldRef="/input/justification"/>
          <orqix:input name="title" fieldRef="/input/equipment"/>
          <orqix:result name="orderId" output="procurementId"/>
        </orqix:child>
      </extensionElements>
    </serviceTask>
    <exclusiveGateway id="equipmentOutcome" name="Was the equipment approved?" default="t16"/>
    <serviceTask id="notifyReady" name="Tell requester onboarding is ready" flowable:delegateExpression="${orqixNotificationTask}">
      <extensionElements>
        <orqix:notification channel="inApp" recipient="initiator" message="Onboarding is ready: access, desk and equipment are arranged."/>
      </extensionElements>
    </serviceTask>
    <endEvent id="ready" name="Ready">
      <extensionElements>
        <orqix:outcome label="Ready" kind="success"/>
      </extensionElements>
    </endEvent>
    <serviceTask id="notifyEquipmentRejected" name="Tell requester equipment was not approved" flowable:delegateExpression="${orqixNotificationTask}">
      <extensionElements>
        <orqix:notification channel="inApp" recipient="initiator" message="The equipment purchase was not approved. Open the request to see the details."/>
      </extensionElements>
    </serviceTask>
    <endEvent id="equipmentRejected" name="Equipment not approved">
      <extensionElements>
        <orqix:outcome label="Equipment rejected" kind="rejected"/>
      </extensionElements>
      <terminateEventDefinition/>
    </endEvent>
    <serviceTask id="notifyRejected" name="Tell requester onboarding was rejected" flowable:delegateExpression="${orqixNotificationTask}">
      <extensionElements>
        <orqix:notification channel="inApp" recipient="initiator" message="Onboarding was rejected. Open the request to see the reason."/>
      </extensionElements>
    </serviceTask>
    <endEvent id="rejected" name="Rejected">
      <extensionElements>
        <orqix:outcome label="Rejected" kind="rejected"/>
      </extensionElements>
      <terminateEventDefinition/>
    </endEvent>
    <sequenceFlow id="t1" sourceRef="start" targetRef="setup"/>
    <sequenceFlow id="t2" name="IT" sourceRef="setup" targetRef="it"/>
    <sequenceFlow id="t3" name="Facilities" sourceRef="setup" targetRef="facilities"/>
    <sequenceFlow id="t4" sourceRef="it__route" targetRef="itReady">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${orqixRoute.approved(execution, 'it')}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="t5" sourceRef="it__route" targetRef="notifyRejected">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${orqixRoute.rejected(execution, 'it')}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="t6" name="No decision in 4 hours" sourceRef="it__timeout" targetRef="itEscalation"/>
    <sequenceFlow id="t7" sourceRef="itEscalation__route" targetRef="itReady">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${orqixRoute.approved(execution, 'itEscalation')}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="t8" sourceRef="itEscalation__route" targetRef="notifyRejected">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${orqixRoute.rejected(execution, 'itEscalation')}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="t9" sourceRef="itReady" targetRef="setupDone"/>
    <sequenceFlow id="t10" sourceRef="facilities__route" targetRef="setupDone">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${orqixRoute.approved(execution, 'facilities')}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="t11" sourceRef="facilities__route" targetRef="notifyRejected">
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${orqixRoute.rejected(execution, 'facilities')}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="t12" sourceRef="setupDone" targetRef="leadTime"/>
    <sequenceFlow id="t13" sourceRef="leadTime" targetRef="orderEquipment"/>
    <sequenceFlow id="t14" sourceRef="orderEquipment" targetRef="equipmentOutcome"/>
    <sequenceFlow id="t15" name="Equipment approved" sourceRef="equipmentOutcome" targetRef="notifyReady">
      <extensionElements>
        <orqix:condition fieldRef="/steps/orderEquipment/outcomeKind" operator="eq" valueType="string" value="success"/>
      </extensionElements>
      <conditionExpression xsi:type="tFormalExpression"><![CDATA[${orqixRoute.condition(execution, 't15')}]]></conditionExpression>
    </sequenceFlow>
    <sequenceFlow id="t16" name="Otherwise" sourceRef="equipmentOutcome" targetRef="notifyEquipmentRejected"/>
    <sequenceFlow id="t17" sourceRef="notifyReady" targetRef="ready"/>
    <sequenceFlow id="t18" sourceRef="notifyEquipmentRejected" targetRef="equipmentRejected"/>
    <sequenceFlow id="t19" sourceRef="notifyRejected" targetRef="rejected"/>
  </process>
