{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orqix.example/schemas/connection-definition-v0.schema.json",
  "title": "Orqix connection definition v0.1 \u2014 portable HTTP operation or AI agent contract",
  "description": "Immutable, versioned, secret-free description of an approved integration: kind http (default) is an HTTP operation contract, kind agent is a bounded AI task that may call allow-listed tools of one MCP server (S13). Environment details (base URL or MCP endpoint, credential reference, enabled flag) live in the connection binding, which is not portable and never exported. See docs/build/S5-runtime.md for retry and effect semantics and docs/build/S13-agents-mcp.md for agents.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "kind": {
      "description": "http (default): operations are HTTP calls. agent: operations are bounded AI tasks that call allow-listed tools of the MCP server in the binding; effect class is always readOnly. microsoftGraph: read-only document metadata or pinned-version UTF-8 text through Microsoft Graph. mcpServer (CG-M01, docs/build/S135): a registered MCP tool server: its binding is the endpoint and its definition is the tool catalog agents may reference as <key>.<tool> (no operations).",
      "enum": [
        "http",
        "agent",
        "microsoftGraph",
        "mcpServer"
      ]
    },
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 20,
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]{0,63}$"
      }
    },
    "mcpServer": {
      "$ref": "#/$defs/mcpServerSpec"
    }
  },
  "required": [
    "schemaVersion",
    "key",
    "version",
    "name"
  ],
  "additionalProperties": false,
  "$defs": {
    "operation": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH"
          ]
        },
        "path": {
          "description": "Static path appended to the binding base URL. No templates or query strings in v0.",
          "type": "string",
          "pattern": "^/[A-Za-z0-9._~/-]{0,200}$"
        },
        "requestSchema": {
          "description": "Flat JSON body. Required for POST/PUT/PATCH, forbidden for GET (compiler rule CONN_REQUEST_SCHEMA).",
          "$ref": "#/$defs/requestObject"
        },
        "responseSchema": {
          "$ref": "#/$defs/responseObject"
        },
        "successStatuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 200,
            "maximum": 299
          }
        },
        "effectClass": {
          "description": "readOnly: no remote side effect, retried freely. idempotentWithKey: remote deduplicates by the idempotency header, retried with the same key. nonIdempotent: retried only when the request provably was not sent; otherwise the outcome is unknown and an operator must reconcile.",
          "enum": [
            "readOnly",
            "idempotentWithKey",
            "nonIdempotent"
          ]
        },
        "idempotencyHeader": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]{0,63}$"
        },
        "maxTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "testable": {
          "description": "May be invoked from the connection test endpoint. Only allowed for readOnly operations.",
          "type": "boolean"
        }
      },
      "required": [
        "label",
        "method",
        "path",
        "responseSchema",
        "successStatuses",
        "effectClass",
        "maxTimeoutSeconds",
        "testable"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "effectClass": {
                "const": "idempotentWithKey"
              }
            }
          },
          "then": {
            "required": [
              "idempotencyHeader"
            ]
          },
          "else": {
            "not": {
              "required": [
                "idempotencyHeader"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "testable": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "effectClass": {
                "const": "readOnly"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "method": {
                "const": "GET"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "requestSchema"
              ]
            }
          },
          "else": {
            "required": [
              "requestSchema"
            ]
          }
        }
      ]
    },
    "scalarField": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean"
          ]
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "pattern": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "requestObject": {
      "type": "object",
      "properties": {
        "type": {
          "const": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "properties": {
          "type": "object",
          "maxProperties": 30,
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z0-9]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/scalarField"
          }
        },
        "additionalProperties": {
          "const": false
        }
      },
      "required": [
        "type",
        "properties",
        "additionalProperties"
      ],
      "additionalProperties": false
    },
    "responseObject": {
      "description": "Remote APIs may add fields; unknown fields are ignored unless additionalProperties is false. Nesting is limited to three object levels by rule CONN_RESPONSE_DEPTH. Arrays are not mappable in v0.",
      "type": "object",
      "properties": {
        "type": {
          "const": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "properties": {
          "type": "object",
          "maxProperties": 50,
          "additionalProperties": {
            "oneOf": [
              {
                "$ref": "#/$defs/scalarField"
              },
              {
                "$ref": "#/$defs/responseObject"
              }
            ]
          }
        },
        "additionalProperties": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "properties"
      ],
      "additionalProperties": false
    },
    "agentOperation": {
      "description": "An AI task: a fixed instruction, an allow-list of MCP tools, structured input and a structured result. requestSchema is the input (flat scalars, mapped from workflow fields like an HTTP request); responseSchema is the result the agent must produce (additionalProperties false).",
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "requestSchema": {
          "$ref": "#/$defs/requestObject"
        },
        "responseSchema": {
          "allOf": [
            {
              "$ref": "#/$defs/responseObject"
            },
            {
              "required": [
                "required",
                "additionalProperties"
              ],
              "properties": {
                "additionalProperties": {
                  "const": false
                }
              }
            }
          ]
        },
        "effectClass": {
          "description": "The agent task itself is repeatable: always readOnly. Approved write tools (agentSpec.writeTools, IN04, docs/build/S75) are journaled as their own nonIdempotent effects, never through this class.",
          "const": "readOnly"
        },
        "maxTimeoutSeconds": {
          "description": "Wall-clock limit for the whole model and tool loop.",
          "type": "integer",
          "minimum": 1,
          "maximum": 30
        },
        "testable": {
          "type": "boolean"
        },
        "agent": {
          "$ref": "#/$defs/agentSpec"
        }
      },
      "required": [
        "label",
        "requestSchema",
        "responseSchema",
        "effectClass",
        "maxTimeoutSeconds",
        "testable",
        "agent"
      ],
      "additionalProperties": false
    },
    "agentSpec": {
      "type": "object",
      "properties": {
        "instructions": {
          "description": "Fixed system prompt written by an administrator and versioned with the connection version. Run data is never part of it.",
          "type": "string",
          "minLength": 20,
          "maxLength": 4000
        },
        "modelProfile": {
          "description": "Model profile of the AI settings (never a raw model id). Omitted: the deployment default profile.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,31}$"
        },
        "tools": {
          "description": "Allow-list of tools. Only these are offered to the model and only these can be called: tools of the MCP server in the binding, <server>.<tool> of registered tool servers, and Orqix tools with a source.",
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/agentTool"
          }
        },
        "maxToolCalls": {
          "description": "Upper bound on tool calls in one execution; further calls are refused.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "summary": {
          "description": "Business sentence shown on the run timeline, after the connection name. {field} is replaced by a request or result value, {tools} by the labels of the tools that were called.",
          "type": "string",
          "maxLength": 300
        },
        "writeTools": {
          "description": "Write-capable tools (IN04, docs/build/S75). Each sends one message through a workspace adapter to targets fixed here, never chosen by the model. Declaring a tool authorizes nothing: it is offered to the model only while a person holding agent.approve-write-tool has approved it for the workflow, this connection version, operation and tool, and the run was not started by that approver. Delivery uses the local stub transport only in this build.",
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/agentWriteTool"
          }
        },
        "loop": {
          "description": "CG-M03 durable loop: each model turn runs as its own engine job, long tools (workflow, askPerson, approvals, elicitation) become waits, and the state between turns is encrypted and short-lived. Without loop the agent runs synchronously within maxTimeoutSeconds.",
          "type": "object",
          "properties": {
            "maxTurns": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            },
            "maxToolCalls": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            },
            "maxDuration": {
              "description": "ISO-8601 duration from the first turn, at most P7D.",
              "type": "string",
              "pattern": "^P(?:\\d+D)?(?:T(?:\\d+H)?(?:\\d+M)?(?:\\d+S)?)?$"
            },
            "budgetUsd": {
              "description": "Most this agent step may spend in one run, within the workspace budget.",
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "maxTurns",
            "maxToolCalls",
            "maxDuration",
            "budgetUsd"
          ],
          "additionalProperties": false
        },
        "resources": {
          "description": "Read-only resources of registered tool servers (<server key>.<resource name>) given to the model as untrusted reference data.",
          "type": "array",
          "uniqueItems": true,
          "maxItems": 8,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]\\.[a-z][A-Za-z0-9_-]{0,31}$"
          }
        },
        "elicitation": {
          "description": "MCP elicitation requests become a task for this group (needs loop). Without it every elicitation is declined.",
          "type": "object",
          "properties": {
            "group": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$"
            }
          },
          "required": [
            "group"
          ],
          "additionalProperties": false
        },
        "inputDataClasses": {
          "description": "Data class of request fields (default internal). A tool argument carrying the value of a field whose class the tool may not receive is refused.",
          "type": "object",
          "maxProperties": 50,
          "additionalProperties": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "personal"
            ]
          }
        }
      },
      "required": [
        "instructions",
        "tools",
        "maxToolCalls"
      ],
      "additionalProperties": false
    },
    "agentTool": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Tool name: a tool of the MCP server in the agent's own binding, <mcpServer connection key>.<tool name> of a registered tool server (CG-M01), or the name of an Orqix tool with a source (CG-M02).",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,127}$"
        },
        "label": {
          "description": "Business name of the tool or the system behind it, shown in the studio and on the run timeline.",
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "description": "Optional administrator-written tool description offered to the model instead of the server's own description (which is untrusted).",
          "type": "string",
          "maxLength": 500
        },
        "source": {
          "description": "CG-M02: an Orqix tool instead of an MCP tool. operation: a connection operation (inherits its effect class and journal); decision: a pinned shared decision table; workflow: starts a pinned child release and waits for its outcome; askPerson: a task for a group with a typed answer form. workflow and askPerson need agent.loop.",
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "operation": {
                  "type": "object",
                  "properties": {
                    "connection": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$"
                    },
                    "operation": {
                      "type": "string",
                      "pattern": "^[a-z][A-Za-z0-9]{0,63}$"
                    }
                  },
                  "required": [
                    "connection",
                    "operation"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "operation"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "decision": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$"
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "key",
                    "version"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "decision"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "workflow": {
                  "type": "object",
                  "properties": {
                    "key": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$"
                    },
                    "release": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "key",
                    "release"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "workflow"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "askPerson": {
                  "type": "object",
                  "properties": {
                    "group": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$"
                    },
                    "answerSchema": {
                      "$ref": "#/$defs/requestObject"
                    }
                  },
                  "required": [
                    "group",
                    "answerSchema"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "askPerson"
              ],
              "additionalProperties": false
            }
          ]
        },
        "requiresApproval": {
          "description": "CG-M03: the loop pauses before every call of this tool; a member of the group sees the proposed arguments and only an approval releases the call. Needs agent.loop.",
          "type": "object",
          "properties": {
            "group": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$"
            }
          },
          "required": [
            "group"
          ],
          "additionalProperties": false
        },
        "write": {
          "description": "Marks an operation tool whose effect class is nonIdempotent: offered only under an active S75 approval for the workflow, connection version, operation and tool, never on the approver's own requests.",
          "type": "boolean"
        },
        "dataClasses": {
          "description": "Data classes this tool may receive (default public and internal; tools of registered servers take theirs from the server definition).",
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "personal"
            ]
          }
        }
      },
      "required": [
        "name",
        "label"
      ],
      "additionalProperties": false
    },
    "agentWriteTool": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Tool name offered to the model. Must differ from every name in tools.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,47}$"
        },
        "label": {
          "description": "Business name shown to approvers, operators and on the run timeline.",
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "description": "Administrator-written description offered to the model. The model can only fill the message text; targets are fixed.",
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "adapter": {
          "description": "Key of the workspace adapter (IN02) that delivers the message. Its allowlist is checked at publish and before every send.",
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$"
        },
        "kind": {
          "description": "email: the model writes subject and body. teams: the model writes text and an optional title.",
          "enum": [
            "email",
            "teams"
          ]
        },
        "to": {
          "description": "email only: fixed recipient addresses. Never taken from model output or request data.",
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[A-Za-z0-9._%+-]{1,64}@[A-Za-z0-9-]{1,63}(\\.[A-Za-z0-9-]{1,63})+$"
          }
        },
        "maxCalls": {
          "description": "Upper bound on uses of this tool in one execution (default 1).",
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        }
      },
      "required": [
        "name",
        "label",
        "description",
        "adapter",
        "kind"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "email"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "to"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "teams"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "to"
              ]
            }
          }
        }
      ]
    },
    "mcpServerSpec": {
      "description": "Tool catalog of an MCP server (CG-M01). Only these tools can be referenced by agents (as <connection key>.<tool name>); each is pinned per workspace by a tool snapshot that records the SHA-256 of its inputSchema, and a tool whose live schema differs from the pin is refused (TOOL_SCHEMA_CHANGED).",
      "type": "object",
      "properties": {
        "tools": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/mcpServerTool"
          }
        },
        "resources": {
          "description": "Read-only resources agents may read as context (resources/read of a fixed URI, text only, capped).",
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/mcpResource"
          }
        }
      },
      "required": [
        "tools"
      ],
      "additionalProperties": false
    },
    "mcpServerTool": {
      "type": "object",
      "properties": {
        "name": {
          "description": "Tool name as listed by the MCP server.",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.-]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "description": {
          "description": "Administrator-written description offered to the model. The server's own description is never offered (tool poisoning).",
          "type": "string",
          "minLength": 10,
          "maxLength": 500
        },
        "dataClasses": {
          "description": "Data classes this tool may receive in its arguments (default public and internal). Request values of other classes are refused before the call.",
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "enum": [
              "public",
              "internal",
              "confidential",
              "personal"
            ]
          }
        }
      },
      "required": [
        "name",
        "label",
        "description"
      ],
      "additionalProperties": false
    },
    "mcpResource": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9_-]{0,31}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "uri": {
          "type": "string",
          "minLength": 3,
          "maxLength": 500,
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
        },
        "maxChars": {
          "type": "integer",
          "minimum": 100,
          "maximum": 20000
        }
      },
      "required": [
        "name",
        "label",
        "uri",
        "maxChars"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "agent"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "operations": {
            "additionalProperties": {
              "$ref": "#/$defs/agentOperation"
            }
          }
        }
      },
      "else": {
        "properties": {
          "operations": {
            "additionalProperties": {
              "$ref": "#/$defs/operation"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "microsoftGraph"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "operations": {
            "additionalProperties": {
              "properties": {
                "method": {
                  "const": "POST"
                },
                "path": {
                  "enum": [
                    "/metadata",
