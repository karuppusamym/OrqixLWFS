{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orqix.example/schemas/workflow-v0.schema.json",
  "title": "Orqix canonical workflow v0.1 \u2014 R0 executable subset",
  "description": "Structural contract for the R0 business-editor subset. Passing this schema does not establish graph correctness, type safety, authorization or deployability; the compiler rules in docs/build/S4-workflow-compiler.md are mandatory. Pre-freeze revision 2026-10-07: effect class moved to the connection operation, form keyword subset constrained, generic end outcomes, security block redefined.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "workflowKey": {
      "$ref": "#/$defs/key"
    },
    "name": {
      "$ref": "#/$defs/label"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "uniqueItems": true
        }
      },
      "required": [
        "description"
      ],
      "additionalProperties": false
    },
    "inputSchema": {
      "$ref": "#/$defs/formSchema"
    },
    "inputUi": {
      "type": "object",
      "description": "Presentation hints for the request form. Never affects validation or execution.",
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldKey"
          },
          "uniqueItems": true
        },
        "widgets": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/fieldKey"
          },
          "additionalProperties": {
            "enum": [
              "text",
              "textarea",
              "number",
              "money",
              "select",
              "radio",
              "checkbox"
            ]
          }
        },
        "currency": {
          "const": "USD"
        }
      },
      "additionalProperties": false
    },
    "outputSchema": {
      "$ref": "#/$defs/formSchema"
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "manual",
          "api"
        ]
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/startNode"
          },
          {
            "$ref": "#/$defs/approvalNode"
          },
          {
            "$ref": "#/$defs/decisionNode"
          },
          {
            "$ref": "#/$defs/branchNode"
          },
          {
            "$ref": "#/$defs/httpNode"
          },
          {
            "$ref": "#/$defs/notificationNode"
          },
          {
            "$ref": "#/$defs/parallelSplitNode"
          },
          {
            "$ref": "#/$defs/parallelJoinNode"
          },
          {
            "$ref": "#/$defs/waitNode"
          },
          {
            "$ref": "#/$defs/startWorkflowNode"
          },
          {
            "$ref": "#/$defs/endNode"
          }
        ]
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/decisionTable"
      }
    },
    "execution": {
      "type": "object",
      "description": "maxAttempts/retryDelaySeconds apply only to external service work (http nodes), never to human decisions.",
      "properties": {
        "maxConcurrentRuns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "retryDelaySeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 3600
        }
      },
      "required": [
        "maxConcurrentRuns",
        "maxAttempts",
        "retryDelaySeconds"
      ],
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "description": "Per-workflow policy. Platform permissions (workflow.start, workflow.publish) are product-defined and not configurable here. Candidate groups are derived from approval nodes.",
      "properties": {
        "selfApproval": {
          "description": "deny: the run initiator can never claim or decide its tasks. allow: only accepted by the compiler in a workspace whose policy permits it (test workspaces); every such decision is audited with policy=selfApprovalAllowed.",
          "enum": [
            "deny",
            "allow"
          ]
        }
      },
      "required": [
        "selfApproval"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "connections": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "$ref": "#/$defs/key"
              },
              "definitionVersion": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "key",
              "definitionVersion"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "connections"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/fieldKey"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "fieldRef": {
            "$ref": "#/$defs/fieldRef"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "fieldRef",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "uiLayout": {
      "type": "object",
      "description": "Canvas presentation only. Excluded from the semantic hash; never affects execution.",
      "properties": {
        "positions": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/id"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "viewport": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "zoom": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "x",
            "y",
            "zoom"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "positions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "workflowKey",
    "name",
    "metadata",
    "inputSchema",
    "outputSchema",
    "triggers",
    "nodes",
    "transitions",
    "decisions",
    "execution",
    "security",
    "dependencies",
    "outputMapping"
  ],
  "additionalProperties": false,
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,62}[a-z0-9]$"
    },
    "id": {
      "description": "Node/transition identifier. Stable through compilation; becomes the BPMN element ID. Double underscore is reserved for compiler-generated elements.",
      "type": "string",
      "pattern": "^(?!.*__)[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "fieldKey": {
      "type": "string",
      "pattern": "^[a-z][A-Za-z0-9]{0,63}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "fieldRef": {
      "description": "/input/<fieldKey> or /steps/<nodeId>/<outputKey>. Exactly one level below input or a step in v0.",
      "type": "string",
      "pattern": "^/(input/[a-z][A-Za-z0-9]{0,63}|steps/(?!.*__)[A-Za-z][A-Za-z0-9_-]{0,63}/[a-z][A-Za-z0-9]{0,63})$"
    },
    "literal": {
      "description": "Comparison/output literal. String literals are additionally restricted by compiler rule WF_LITERAL_UNSAFE.",
      "type": [
        "string",
        "number",
        "boolean"
      ]
    },
    "condition": {
      "if": {
        "required": [
          "all"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "all": {
            "type": "array",
            "minItems": 2,
            "maxItems": 8,
            "items": {
              "$ref": "#/$defs/atomicCondition"
            }
          }
        },
        "required": [
          "all"
        ],
        "additionalProperties": false
      },
      "else": {
        "if": {
          "required": [
            "any"
          ]
        },
        "then": {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "minItems": 2,
              "maxItems": 8,
              "items": {
                "$ref": "#/$defs/atomicCondition"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        "else": {
          "$ref": "#/$defs/atomicCondition"
        }
      }
    },
    "formSchema": {
      "description": "Approved JSON Schema keyword subset for request/output forms. No pattern, $ref, format other than date, nested objects, arrays or remote schemas in v0.",
      "type": "object",
      "properties": {
        "type": {
          "const": "object"
        },
        "additionalProperties": {
          "const": false
        },
        "required": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fieldKey"
          },
          "uniqueItems": true
        },
        "properties": {
          "type": "object",
          "maxProperties": 30,
          "propertyNames": {
            "$ref": "#/$defs/fieldKey"
          },
          "additionalProperties": {
            "$ref": "#/$defs/formField"
          }
        }
      },
      "required": [
        "type",
        "additionalProperties",
        "properties"
      ],
      "additionalProperties": false
    },
    "formField": {
      "if": {
        "properties": {
          "type": {
            "const": "array"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/arrayFormField"
      },
      "else": {
        "$ref": "#/$defs/scalarFormField"
      }
    },
    "nodeBase": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "label": {
          "$ref": "#/$defs/label"
        },
        "config": {
          "type": "object"
        }
      },
      "required": [
        "id",
        "type",
        "label",
        "config"
      ]
    },
    "startNode": {
      "allOf": [
        {
          "$ref": "#/$defs/nodeBase"
        }
      ],
      "properties": {
        "id": true,
        "label": true,
        "type": {
          "const": "start"
        },
        "config": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "approvalNode": {
      "allOf": [
        {
          "$ref": "#/$defs/nodeBase"
        }
      ],
      "properties": {
        "id": true,
        "label": true,
        "type": {
          "const": "approval"
        },
        "config": {
          "type": "object",
          "description": "Outputs at /steps/<id>/: decision (approved|rejected), reason, comment, decidedBy, decidedAt.",
          "properties": {
            "candidateGroupRef": {
              "$ref": "#/$defs/key"
            },
            "rejectReasonRequired": {
              "const": true
            },
            "dueAfterHours": {
              "description": "Display-only due date in R0. No reminder or escalation is executed.",
              "type": "integer",
              "minimum": 1,
              "maximum": 720
            },
            "timeoutAfter": {
              "description": "Optional. When nobody decides within this time, the approval ends and the request continues on the timedOut route (for example to an escalation approval, or to a rejection). Adds a timedOut route and the decision value timedOut. See S12.",
              "$ref": "#/$defs/duration"
            }
          },
          "required": [
            "candidateGroupRef",
            "rejectReasonRequired"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "decisionNode": {
      "allOf": [
        {
          "$ref": "#/$defs/nodeBase"
        }
      ],
      "properties": {
        "id": true,
        "label": true,
        "type": {
          "const": "decision"
        },
        "config": {
          "type": "object",
          "description": "Outputs at /steps/<id>/<outputKey> for every key in the table's then/default objects.",
          "properties": {
            "decisionRef": {
              "$ref": "#/$defs/key"
            }
          },
          "required": [
            "decisionRef"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "branchNode": {
      "allOf": [
        {
          "$ref": "#/$defs/nodeBase"
        }
      ],
      "properties": {
        "id": true,
        "label": true,
        "type": {
          "const": "branch"
        },
        "config": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "httpNode": {
      "allOf": [
        {
          "$ref": "#/$defs/nodeBase"
        }
      ],
      "properties": {
        "id": true,
        "label": true,
        "type": {
          "const": "http"
        },
        "config": {
          "type": "object",
          "description": "Effect class, idempotency header and success statuses come from the pinned connection operation, never from the workflow.",
          "properties": {
            "connectionRef": {
              "$ref": "#/$defs/key"
            },
            "operation": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]{0,63}$"
            },
            "inputMapping": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/fieldKey"
              },
              "additionalProperties": {
                "$ref": "#/$defs/fieldRef"
              }
            },
            "resultMapping": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": {
                "$ref": "#/$defs/fieldKey"
              },
              "additionalProperties": {
                "description": "JSON Pointer (RFC 6901) into the response body.",
                "type": "string",
                "pattern": "^(/([^~/]|~[01])*)+$"
              }
            },
            "timeoutSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "required": [
            "connectionRef",
            "operation",
            "inputMapping",
            "resultMapping",
            "timeoutSeconds"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "notificationNode": {
      "allOf": [
        {
          "$ref": "#/$defs/nodeBase"
        }
      ],
      "properties": {
        "id": true,
        "label": true,
        "type": {
          "const": "notification"
        },
        "config": {
          "type": "object",
          "properties": {
            "channel": {
              "const": "inApp"
            },
            "recipient": {
              "const": "initiator"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "required": [
            "channel",
            "recipient",
            "message"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "duration": {
      "description": "ISO-8601 duration in days, hours and minutes only (for example PT1M, PT48H, P2D, P1DT12H). The compiler enforces PT1M to P90D (WF_DURATION_TOO_SHORT, WF_DURATION_TOO_LONG).",
      "type": "string",
      "maxLength": 20,
      "pattern": "^P(?=\\d|T\\d)(\\d{1,3}D)?(T(?=\\d)(\\d{1,4}H)?(\\d{1,5}M)?)?$"
    },
    "parallelSplitNode": {
      "allOf": [
        {
          "$ref": "#/$defs/nodeBase"
        }
      ],
      "properties": {
        "id": true,
        "label": true,
        "type": {
          "const": "parallelSplit"
        },
        "config": {
          "type": "object",
          "description": "Run in parallel: every outgoing next transition starts one branch. joinRef names the parallelJoin step where all branches must meet.",
          "properties": {
            "joinRef": {
              "$ref": "#/$defs/id"
            }
          },
          "required": [
            "joinRef"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "parallelJoinNode": {
      "allOf": [
        {
          "$ref": "#/$defs/nodeBase"
        }
      ],
      "properties": {
        "id": true,
        "label": true,
        "type": {
          "const": "parallelJoin"
        },
        "config": {
          "type": "object",
          "description": "Wait for all: continues once every branch of the matching parallelSplit has finished.",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "waitNode": {
      "allOf": [
        {
          "$ref": "#/$defs/nodeBase"
        }
      ],
      "properties": {
        "id": true,
        "label": true,
        "type": {
          "const": "wait"
        },
        "config": {
          "type": "object",
          "description": "Wait before the request continues: either for a fixed time (duration) or until a calendar date held in a date field (untilField, with an optional atTime, UTC). Exactly one of the two is required (compiler rule WF_WAIT_CHOICE). The timer runs on the job executor and survives restarts.",
          "properties": {
            "duration": {
              "$ref": "#/$defs/duration"
            },
            "untilField": {
              "$ref": "#/$defs/fieldRef"
            },
            "atTime": {
              "description": "Time of day (UTC, HH:mm, default 09:00) at which the wait ends on the date of untilField.",
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            }
          },
          "dependentRequired": {
            "atTime": [
              "untilField"
            ]
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "startWorkflowNode": {
      "allOf": [
        {
          "$ref": "#/$defs/nodeBase"
        }
      ],
      "properties": {
        "id": true,
        "label": true,
        "type": {
          "const": "startWorkflow"
        },
        "config": {
          "type": "object",
          "description": "Start another workflow as a child request and continue when it finishes. Outputs at /steps/<id>/: outcome, outcomeKind, reference and every key of resultMapping. The child release is pinned when this workflow is published.",
          "properties": {
            "workflowRef": {
              "description": "Key of the workflow to start.",
              "$ref": "#/$defs/key"
            },
            "repeat": {
              "description": "Repeat sequential pinned child requests until an outcome matches, or the bound is reached. Every occurrence preserves its own tasks and effects. Inputs are reused. Cancellation stops repetition. Results include iterations and limitReached.",
              "type": "object",
              "properties": {
                "maxIterations": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 25
                },
                "untilOutcome": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                }
              },
              "required": [
                "maxIterations",
                "untilOutcome"
              ],
              "additionalProperties": false
            },
            "inputMapping": {
              "description": "Child request field -> value from this request.",
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/fieldKey"
              },
              "additionalProperties": {
                "$ref": "#/$defs/fieldRef"
              }
            },
            "resultMapping": {
              "description": "Output name in this request -> result field of the child (its outputSchema).",
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/fieldKey"
              },
              "additionalProperties": {
                "$ref": "#/$defs/fieldKey"
              }
            },
            "forEach": {
              "type": "object",
              "description": "Sequentially start one pinned child per scalar item. The collection must contain 1 to 25 items. Inputs share inputMapping and itemInput receives the current item. Results are the last child result plus iterations and limitReached=false.",
              "properties": {
                "itemsRef": {
                  "type": "string",
                  "pattern": "^/input/[a-z][A-Za-z0-9]{0,63}$"
                },
                "itemInput": {
                  "$ref": "#/$defs/fieldKey"
                },
                "maxItems": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 25
                },
                "mode": {
                  "enum": [
                    "sequential",
                    "parallel"
                  ],
                  "default": "sequential"
                }
              },
              "required": [
                "itemsRef",
                "itemInput",
                "maxItems"
              ],
              "additionalProperties": false
            },
            "collectionMapping": {
              "description": "Collected output name -> guaranteed scalar child result field, or outcome/outcomeKind/reference. For collection iteration only. Values follow input item order.",
              "type": "object",
              "propertyNames": {
                "$ref": "#/$defs/fieldKey"
              },
              "additionalProperties": {
                "$ref": "#/$defs/fieldKey"
              }
            }
          },
          "required": [
            "workflowRef",
            "inputMapping",
            "resultMapping"
          ],
          "additionalProperties": false,
          "not": {
            "required": [
              "repeat",
              "forEach"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "endNode": {
      "allOf": [
        {
          "$ref": "#/$defs/nodeBase"
        }
      ],
      "properties": {
        "id": true,
        "label": true,
        "type": {
          "const": "end"
        },
        "config": {
          "type": "object",
          "properties": {
            "businessOutcome": {
              "description": "Business-facing outcome label shown to users, e.g. Fulfilled, Rejected, Completed.",
              "type": "string",
              "pattern": "^[A-Z][A-Za-z ]{0,39}$"
            },
            "outcomeKind": {
              "description": "Reporting class. A rejected business outcome is a completed process, not a technical failure.",
              "enum": [
                "success",
                "rejected"
              ]
            }
          },
          "required": [
            "businessOutcome",
            "outcomeKind"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "from": {
          "$ref": "#/$defs/id"
        },
        "to": {
          "$ref": "#/$defs/id"
        },
        "on": {
          "enum": [
            "next",
            "approved",
            "rejected",
            "timedOut",
            "condition",
            "default"
          ]
        },
        "label": {
          "description": "Optional business explanation shown on the canvas, e.g. 'USD 5,000 or more'.",
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "condition": {
          "$ref": "#/$defs/condition"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "on"
      ],
      "additionalProperties": false,
      "if": {
        "properties": {
          "on": {
            "const": "condition"
          }
        },
        "required": [
          "on"
        ]
      },
      "then": {
        "required": [
          "condition"
        ]
      },
      "else": {
        "not": {
          "required": [
            "condition"
          ]
        }
      }
    },
    "decisionTable": {
      "type": "object",
      "description": "Authoring semantics: at most one row matches (UNIQUE); the default applies only when no row matches. All rows test the same field (compiler rule WF_DECISION_MIXED_FIELDS) and must be pairwise disjoint (WF_DECISION_OVERLAP). Compiled to DMN as FIRST with a trailing catch-all row.",
      "properties": {
        "key": {
          "$ref": "#/$defs/key"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "hitPolicy": {
          "const": "UNIQUE"
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "properties": {
              "when": {
                "$ref": "#/$defs/atomicCondition"
              },
              "then": {
                "$ref": "#/$defs/decisionOutput"
              }
            },
            "required": [
              "when",
              "then"
            ],
            "additionalProperties": false
          }
        },
        "default": {
          "$ref": "#/$defs/decisionOutput"
        }
      },
      "required": [
        "key",
        "version",
        "hitPolicy",
        "rows",
        "default"
      ],
      "additionalProperties": false
    },
    "decisionOutput": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 10,
      "propertyNames": {
        "$ref": "#/$defs/fieldKey"
      },
      "additionalProperties": {
        "$ref": "#/$defs/literal"
      }
    },
    "scalarFormField": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "string",
            "number",
            "integer",
            "boolean"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "format": {
          "description": "date: a calendar date written YYYY-MM-DD, without time or time zone. Only on type string.",
          "const": "date"
        },
        "formatMinimum": {
          "description": "Earliest allowed date (YYYY-MM-DD, inclusive). Only with format date.",
          "$ref": "#/$defs/calendarDate"
        },
        "formatMaximum": {
          "description": "Latest allowed date (YYYY-MM-DD, inclusive). Only with format date.",
          "$ref": "#/$defs/calendarDate"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "minLength": {
          "type": "integer",
          "minimum": 0
        },
        "maxLength": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "multipleOf": {
          "enum": [
            0.01,
            1
          ]
        }
      },
      "if": {
        "required": [
          "format"
        ]
      },
      "then": {
        "properties": {
          "type": {
            "const": "string"
          }
        }
      },
      "dependentRequired": {
        "formatMinimum": [
          "format"
        ],
        "formatMaximum": [
          "format"
        ]
      },
      "required": [
        "type",
        "title"
      ],
      "additionalProperties": false
    },
    "calendarDate": {
      "description": "A calendar date YYYY-MM-DD. The compiler also rejects dates that do not exist (WF_FORM_INVALID).",
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "arrayFormField": {
      "type": "object",
      "properties": {
        "type": {
          "const": "array"
        },
        "title": {
          "$ref": "#/$defs/label"
        },
        "items": {
          "$ref": "#/$defs/scalarFormField"
        },
        "minItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        },
        "maxItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 25
        }
      },
      "required": [
        "type",
        "title",
        "items",
        "minItems",
        "maxItems"
      ],
      "additionalProperties": false
    },
    "atomicCondition": {
      "type": "object",
      "properties": {
        "fieldRef": {
          "$ref": "#/$defs/fieldRef"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "gte",
            "gt",
            "lt",
            "lte"
          ]
        },
        "value": {
          "$ref": "#/$defs/literal"
        }
      },
      "required": [
        "fieldRef",
        "operator",
        "value"
      ],
      "additionalProperties": false
    }
  }
}
