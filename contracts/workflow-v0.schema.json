{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orqix.example/schemas/workflow-v0.schema.json",
  "title": "Orqix proposed workflow v0.1 — first-release subset",
  "description": "Design contract only. Structural validation does not establish executable semantics, deployment readiness or authorization.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "workflowKey": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "metadata": {
      "type": "object",
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "uniqueItems": true
        }
      },
      "required": [
        "description"
      ],
      "additionalProperties": false
    },
    "inputSchema": {
      "type": "object"
    },
    "outputSchema": {
      "type": "object"
    },
    "triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "manual",
          "api"
        ]
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 50,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "type": {
                "const": "start"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "config": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "label",
              "config"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "type": {
                "const": "approval"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "config": {
                "type": "object",
                "properties": {
                  "candidateGroupRef": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  },
                  "rejectReasonRequired": {
                    "const": true
                  }
                },
                "required": [
                  "candidateGroupRef",
                  "rejectReasonRequired"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "label",
              "config"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "type": {
                "const": "decision"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "config": {
                "type": "object",
                "properties": {
                  "decisionRef": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  }
                },
                "required": [
                  "decisionRef"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "label",
              "config"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "type": {
                "const": "branch"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "config": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "label",
              "config"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "type": {
                "const": "http"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "config": {
                "type": "object",
                "properties": {
                  "connectionRef": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  },
                  "operation": {
                    "type": "string",
                    "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
                  },
                  "inputMapping": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "$ref": "#/$defs/fieldRef"
                    }
                  },
                  "resultMapping": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                      "type": "string",
                      "pattern": "^/"
                    }
                  },
                  "timeoutSeconds": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 30
                  },
                  "effectPolicy": {
                    "enum": [
                      "remoteIdempotency",
                      "manualReconciliation"
                    ]
                  }
                },
                "required": [
                  "connectionRef",
                  "operation",
                  "inputMapping",
                  "resultMapping",
                  "timeoutSeconds",
                  "effectPolicy"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "label",
              "config"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "type": {
                "const": "notification"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "config": {
                "type": "object",
                "properties": {
                  "channel": {
                    "const": "inApp"
                  },
                  "recipient": {
                    "const": "initiator"
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "channel",
                  "recipient",
                  "message"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "label",
              "config"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "type": {
                "const": "end"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "config": {
                "type": "object",
                "properties": {
                  "businessOutcome": {
                    "enum": [
                      "Rejected",
                      "Fulfilled"
                    ]
                  }
                },
                "required": [
                  "businessOutcome"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "label",
              "config"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "on": {
            "enum": [
              "next",
              "approved",
              "rejected",
              "condition",
              "default"
            ]
          },
          "condition": {
            "$ref": "#/$defs/condition"
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "on"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "on": {
                  "const": "condition"
                }
              },
              "required": [
                "on"
              ]
            },
            "then": {
              "required": [
                "condition"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "condition"
                ]
              }
            }
          }
        ]
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "hitPolicy": {
            "const": "UNIQUE"
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "when": {
                  "type": "object",
                  "properties": {
                    "fieldRef": {
                      "$ref": "#/$defs/fieldRef"
                    },
                    "operator": {
                      "enum": [
                        "eq",
                        "gte",
                        "lt"
                      ]
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "fieldRef",
                    "operator",
                    "value"
                  ],
                  "additionalProperties": false
                },
                "then": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                }
              },
              "required": [
                "when",
                "then"
              ],
              "additionalProperties": false
            }
          },
          "default": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          }
        },
        "required": [
          "key",
          "version",
          "hitPolicy",
          "rows",
          "default"
        ],
        "additionalProperties": false
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "maxConcurrentRuns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "retryDelaySeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        }
      },
      "required": [
        "maxConcurrentRuns",
        "maxAttempts",
        "retryDelaySeconds"
      ],
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "properties": {
        "requiredGroupRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "uniqueItems": true
        },
        "publishPermission": {
          "const": "workflow.publish"
        },
        "runPermission": {
          "const": "workflow.start"
        }
      },
      "required": [
        "requiredGroupRefs",
        "publishPermission",
        "runPermission"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "object",
      "properties": {
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              },
              "definitionVersion": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "key",
              "definitionVersion"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "connections"
      ],
      "additionalProperties": false
    },
    "outputMapping": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "fieldRef": {
            "$ref": "#/$defs/fieldRef"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "fieldRef",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "uiLayout": {
      "type": "object",
      "properties": {
        "positions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        },
        "viewport": {
          "type": "object",
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            },
            "zoom": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "x",
            "y",
            "zoom"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "positions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "workflowKey",
    "name",
    "metadata",
    "inputSchema",
    "outputSchema",
    "triggers",
    "nodes",
    "transitions",
    "decisions",
    "execution",
    "security",
    "dependencies",
    "outputMapping"
  ],
  "additionalProperties": false,
  "$defs": {
    "fieldRef": {
      "type": "string",
      "pattern": "^/(input|steps)/[A-Za-z0-9_~/-]+$"
    },
    "condition": {
      "type": "object",
      "properties": {
        "fieldRef": {
          "$ref": "#/$defs/fieldRef"
        },
        "operator": {
          "enum": [
            "eq",
            "gte",
            "lt"
          ]
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "fieldRef",
        "operator",
        "value"
      ],
      "additionalProperties": false
    }
  }
}
