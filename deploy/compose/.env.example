# Copy to deploy/compose/.env to override defaults (the real .env is git-ignored). Everything here is a DEVELOPMENT-ONLY
# value; docker-compose.yml already contains the same defaults, so the stack runs without a .env file.

# --- host ports (all overridable; 8090 is intentionally not used on the host) ---
POSTGRES_HOST_PORT=5432
KEYCLOAK_HOST_PORT=8180
STUB_HOST_PORT=8095
ORQIX_HOST_PORT=8080
ORQIX_MANAGEMENT_HOST_PORT=8081

# --- images ---
POSTGRES_IMAGE=postgres:18-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.0
ORQIX_IMAGE=orqix/orqix:dev

# --- PostgreSQL (roles are created by postgres/init on the FIRST start of an empty volume only) ---
POSTGRES_SUPERUSER_PASSWORD=postgres-dev-only
ORQIX_MIGRATOR_PASSWORD=orqix_migrator
ORQIX_APP_PASSWORD=orqix_app

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin-dev-only
# Must equal the secret of client orqix-web in keycloak/orqix-dev-realm.json. Change both together.
ORQIX_WEB_CLIENT_SECRET=orqix-web-dev-secret

# --- app container (profile `app`) ---
# Arbitrary UID in group 0, like OpenShift's restricted SCC. Any value >= 1000 works.
ORQIX_UID=1000770000
ORQIX_PROFILES=dev
ORQIX_MIGRATE_PROFILES=migrate,dev
ORQIX_JAVA_OPTS=-XX:MaxRAMPercentage=75

# AI assistance (docs/build/S10). Empty = rules-only.
OPENROUTER_API_KEY=
