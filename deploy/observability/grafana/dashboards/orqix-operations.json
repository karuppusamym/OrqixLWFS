    {
      "type": "stat",
      "title": "Outbox dead",
      "description": "",
      "id": 10,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 19
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(orqix_analytics_outbox_dead{job=~\"$job\"})",
          "datasource": {
