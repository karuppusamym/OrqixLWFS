        }
      }
    },
    {
      "type": "row",
      "title": "Retention",
      "collapsed": false,
      "id": 12,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Retention sweeps per hour",
      "description": "",
      "id": 13,
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (outcome) (rate(orqix_retention_requests_total{job=~\"$job\"}[1h])) * 3600",
          "legendFormat": "requests {{outcome}}",
          "datasource": {
