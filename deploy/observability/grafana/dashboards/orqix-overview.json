      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=~\"$job\",method=\"GET\",uri=~\"/api/.*\"}[5m])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
