# Non-secret application configuration, injected as environment variables (Spring relaxed binding).
# Property catalog: docs/build/S1-engineering-baseline.md section 5. Values marked REPLACE are environment-specific and
# are set per overlay. Secrets (database passwords, OIDC client secret, cursor key) come from Secret references in
# deployment.yaml and never appear here. SPRING_PROFILES_ACTIVE is set on the workloads, not here (the migration Job
# runs the same image with profile "migrate").

# --- database (runtime role; the migration Job uses ORQIX_DB_MIGRATOR_USER with the same URL) ---
ORQIX_DB_URL=jdbc:postgresql://postgres.REPLACE.svc.cluster.local:5432/orqix?sslmode=verify-full
ORQIX_DB_USER=orqix_app
ORQIX_DB_MIGRATOR_USER=orqix_migrator
ORQIX_APP_ROLE=orqix_app

# --- identity (OIDC login via the enterprise IdP, decision D05; client secret is a Secret reference) ---
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_ORQIX_PROVIDER=orqix
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_ORQIX_CLIENT_ID=orqix-web
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_ORQIX_AUTHORIZATION_GRANT_TYPE=authorization_code
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_ORQIX_CLIENT_AUTHENTICATION_METHOD=client_secret_basic
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_ORQIX_SCOPE=openid,profile,email
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_ORQIX_REDIRECT_URI={baseUrl}/login/oauth2/code/{registrationId}
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_ORQIX_ISSUER_URI=https://idp.example.com/REPLACE
SPRING_SECURITY_OAUTH2_CLIENT_PROVIDER_ORQIX_USER_NAME_ATTRIBUTE=preferred_username
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://idp.example.com/REPLACE
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES=orqix-api
ORQIX_IDENTITY_GROUPS_CLAIM=groups
# A dedicated, small IdP group. Empty means nobody is bootstrapped as PLATFORM_ADMIN.
ORQIX_IDENTITY_BOOTSTRAP_PLATFORM_ADMIN_GROUPS=REPLACE-orqix-platform-admins

# --- egress policy (docs/build/S6-security.md section 6); host:port list, connection bindings must match exactly ---
ORQIX_EGRESS_ALLOWED_HOSTS=procurement.example.com:443
ORQIX_EGRESS_ALLOWED_PRIVATE_HOSTS=
# Must stay empty outside local development: the prod profile refuses to start otherwise.
ORQIX_EGRESS_PLAIN_HTTP_HOSTS=

# --- secrets directory: one file per secretRef, mounted from the orqix-connection-secrets Secret ---
ORQIX_SECRETS_DIR=/var/run/secrets/orqix

# --- runtime tuning (defaults shown for visibility; S5 section 11 budget: 15 connections per pod) ---
SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE=15
ORQIX_POLICY_CACHE_TTL=60s
