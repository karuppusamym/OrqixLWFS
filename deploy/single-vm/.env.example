# Orqix sovereign single-VM kit: every setting. Copy to .env (git-ignored), then run scripts/install.sh.
#   cp .env.example .env && chmod 600 .env
# scripts/install.sh --generate-secrets fills every value marked GENERATE with a random secret (openssl rand) in .env.
# Never commit .env, certs/ keys or backups/. See docs/sovereign-deployment.md.

# =====================================================================================================================
# 1. Instance
# =====================================================================================================================
# Docker Compose project name. Prefixes every container, network and volume (<name>_pgdata). Two kits on one host need
# two names. Changing it later points the kit at a different (empty) volume.
COMPOSE_PROJECT_NAME=orqix
# Optional parts started with the stack. "keycloak" = the bundled identity provider. Empty = external OIDC (section 4).
COMPOSE_PROFILES=keycloak
# The URL people type, without a trailing slash. Must match the certificate's name. Include the port when not 443.
# Every sign-in redirect, the token issuer and HTTP->HTTPS redirects are derived from it.
ORQIX_PUBLIC_URL=https://orqix.example.internal

# =====================================================================================================================
# 2. Images (pin exact tags or digests; air-gapped hosts load them with scripts/load-images.sh)
# =====================================================================================================================
# Orqix image built from the repository Dockerfile, for example registry.internal/orqix/orqix:0.1.0
ORQIX_IMAGE=orqix/orqix:REPLACE
POSTGRES_IMAGE=postgres:18-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.8.0
PROXY_IMAGE=nginx:1.27-alpine

# =====================================================================================================================
# 3. Network exposure
# =====================================================================================================================
# HTTPS for users (UI, API, sign-in pages under /auth). HTTP only redirects to ORQIX_PUBLIC_URL.
HTTPS_BIND=0.0.0.0
HTTPS_PORT=443
HTTP_BIND=0.0.0.0
HTTP_PORT=80
# Health (/actuator/health/readiness, /liveness) and Prometheus metrics (/actuator/prometheus). Keep on 127.0.0.1, or
# bind to the monitoring interface only.
MANAGEMENT_BIND=127.0.0.1
MANAGEMENT_PORT=8081
# Who may reach the Keycloak admin console (/auth/admin) through the proxy: one IP or CIDR, or "all".
# Requests from the VM itself (127.0.0.1) are always allowed.
KEYCLOAK_ADMIN_ALLOW=127.0.0.1
# Folder with tls.crt (full chain, server certificate first) and tls.key (PEM, unencrypted, readable by the container).
# Bring your own certificate from your CA. scripts/dev-cert.sh makes a self-signed one for tests only.
TLS_CERT_DIR=./certs
# true = PostgreSQL, Keycloak and Orqix sit on a Docker network with no route out of the host (the default and the
# recommended sovereign setting). Set false only when you enable an outbound integration in section 6.
BACKEND_INTERNAL=true

# =====================================================================================================================
# 4. Identity
# =====================================================================================================================
# Realm created on the first start of the bundled Keycloak from keycloak/orqix-realm.json.
ORQIX_REALM=orqix
# OIDC client used by Orqix (confidential, authorization code + PKCE S256). GENERATE
ORQIX_OIDC_CLIENT_ID=orqix-web
ORQIX_OIDC_CLIENT_SECRET=
# IdP group whose members become Platform Admin at sign-in. Keep it small. It is created empty in the bundled realm.
ORQIX_PLATFORM_ADMIN_GROUP=orqix-platform-admins
# Claim holding the user's group names (no paths).
ORQIX_GROUPS_CLAIM=groups
# Bundled Keycloak: temporary master-realm administrator (admin console at ${ORQIX_PUBLIC_URL}/auth/admin/). GENERATE
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_LOG_LEVEL=info
#
# External OIDC provider (in-country ADFS, Entra ID sovereign cloud, another Keycloak, ...): set COMPOSE_PROFILES= (empty),
# register a confidential client with redirect URI ${ORQIX_PUBLIC_URL}/login/oauth2/code/orqix, release a "groups"
# claim, and set all of the following. They are only read when set; empty means "use the bundled Keycloak".
# The Orqix container calls the token, JWK set and userinfo URLs itself: they must be reachable from it
# (BACKEND_INTERNAL=false if the IdP is outside the VM) and, for https with a private CA, trusted by the JVM
# (ORQIX_JAVA_OPTS with -Djavax.net.ssl.trustStore=..., docs/sovereign-deployment.md section 4).
ORQIX_OIDC_ISSUER=
ORQIX_OIDC_AUTHORIZATION_URI=
ORQIX_OIDC_TOKEN_URI=
ORQIX_OIDC_JWK_SET_URI=
ORQIX_OIDC_USER_INFO_URI=
ORQIX_OIDC_END_SESSION_URI=

# =====================================================================================================================
# 5. Database (PostgreSQL inside the kit, never published on a host port)
# =====================================================================================================================
# Passwords are applied when the data volume is first created; changing them later needs ALTER ROLE (doc section 8).
# GENERATE (all four)
POSTGRES_SUPERUSER_PASSWORD=
ORQIX_MIGRATOR_PASSWORD=
ORQIX_APP_PASSWORD=
KEYCLOAK_DB_PASSWORD=
POSTGRES_MAX_CONNECTIONS=100
# About 25 % of the RAM you give PostgreSQL.
POSTGRES_SHARED_BUFFERS=512MB
# Connections held by the one Orqix container (pool size + 5 migration + Keycloak ~10 must stay under max_connections).
ORQIX_DB_POOL_SIZE=15

# =====================================================================================================================
# 6. Application
# =====================================================================================================================
# HMAC key for list cursors. Rotating it only invalidates open list pages. GENERATE
ORQIX_CURSOR_SECRET=
# UID the Orqix containers run as (group 0). Any non-root UID works; the root filesystem is read-only.
ORQIX_UID=1000770000
# JVM options of the app container. Heap = 75 % of the container memory by default.
ORQIX_JAVA_OPTS=-XX:MaxRAMPercentage=75 -XX:+ExitOnOutOfMemoryError -XX:-UsePerfData -Djava.io.tmpdir=/tmp
ORQIX_REMINDERS_ENABLED=true
#
# ---- Outbound connections. All are OFF by default; each one you enable is a data flow out of the VM. ----
# Connection bindings (REST connectors, webhooks, OAuth token endpoints, Microsoft Graph documents): host:port list.
# Empty = no connector may call anything. Also needs BACKEND_INTERNAL=false.
ORQIX_EGRESS_ALLOWED_HOSTS=
# Hosts on private address ranges (in-country systems on your LAN) that connectors may call: host or host:port list.
ORQIX_EGRESS_ALLOWED_PRIVATE_HOSTS=
# AI assistance. Empty = AI off: AI entry points hidden, nothing is ever sent to an AI provider. Setting a key sends
# prompts (workflow descriptions, form text, document excerpts) to ORQIX_AI_BASE_URL.
OPENROUTER_API_KEY=
# OpenRouter-compatible endpoint. Point it at an in-country gateway if you enable AI.
ORQIX_AI_BASE_URL=https://openrouter.ai/api/v1
# E-mail notifications through your own SMTP relay (false = no mail is sent).
ORQIX_MAIL_ENABLED=false
ORQIX_MAIL_HOST=smtp.example.internal
ORQIX_MAIL_PORT=25
ORQIX_MAIL_FROM=workflow@example.internal
ORQIX_MAIL_STARTTLS=true
# Virus scanning of request files with your own clamd (TCP). false = files are stored as "notScanned".
# A ClamAV container on this VM needs offline signature updates (doc section 4).
ORQIX_CLAMAV_ENABLED=false
ORQIX_CLAMAV_HOST=clamav
ORQIX_CLAMAV_PORT=3310

# =====================================================================================================================
# 7. Backups (scripts/backup.sh)
# =====================================================================================================================
# Where backup sets are written. Put it on a different disk, or sync it off the VM (inside the jurisdiction).
BACKUP_DIR=./backups
# Backup sets older than this many days are deleted after a successful backup. 0 = keep everything.
BACKUP_RETENTION_DAYS=14
