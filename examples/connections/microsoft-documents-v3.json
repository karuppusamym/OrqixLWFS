          "eTag",
          "lastModifiedDateTime",
          "size",
          "text",
          "contentSha256"
        ],
        "additionalProperties": false
      },
      "successStatuses": [
        200
      ],
      "effectClass": "readOnly",
      "maxTimeoutSeconds": 30,
      "testable": true
