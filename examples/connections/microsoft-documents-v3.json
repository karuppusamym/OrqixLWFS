            "type": "string"
          },
          "extractedTextSha256": {
            "type": "string"
          },
          "snapshotId": {
            "type": "string"
          },
          "snapshotExpiresAt": {
            "type": "string"
          },
          "pinMode": {
            "type": "string"
          }
        },
        "required": [
          "driveId",
          "itemId",
          "versionId",
          "name",
          "webUrl",
          "eTag",
          "lastModifiedDateTime",
          "size",
          "text",
          "contentSha256",
          "extractionFormat",
          "extractedTextSha256",
          "snapshotId",
          "snapshotExpiresAt",
          "pinMode"
        ],
        "additionalProperties": false
      },
      "successStatuses": [
        200
      ],
      "effectClass": "readOnly",
      "maxTimeoutSeconds": 30,
      "testable": true
    },
    "resolveLink": {
      "label": "Resolve approved Microsoft document link",
      "method": "POST",
      "path": "/resolveLink",
      "requestSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shareUrl"
        ],
        "properties": {
          "shareUrl": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^https://tenant\\.sharepoint\\.com/(?:sites/|:)[^#]+$",
            "description": "Approved tenant document or sharing URL; customize this allowlist before use."
          },
          "driveId": {
            "type": "string",
            "enum": [
              "drive"
            ],
            "description": "Administrator approved resolved-drive policy; callers need not supply this field."
          }
        }
      },
      "responseSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "driveId": {
            "type": "string",
            "enum": [
              "drive"
            ]
          },
          "itemId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "webUrl": {
            "type": "string"
          },
          "eTag": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          }
        },
        "required": [
          "driveId",
          "itemId",
          "name",
          "webUrl",
          "eTag",
          "size"
        ]
      },
      "successStatuses": [
        200
      ],
      "effectClass": "readOnly",
      "maxTimeoutSeconds": 30,
      "testable": true
    },
    "listVersions": {
      "label": "List bounded document version history",
      "method": "POST",
      "path": "/versions",
      "requestSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "driveId": {
            "type": "string",
            "enum": [
              "drive"
            ]
          },
          "itemId": {
            "type": "string"
          }
        },
        "required": [
          "driveId",
          "itemId"
        ]
      },
      "responseSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "driveId": {
            "type": "string"
          },
          "itemId": {
            "type": "string"
          },
          "versionsJson": {
            "type": "string"
          },
          "versionCount": {
            "type": "integer"
          },
          "hasMore": {
            "type": "boolean"
          }
        },
        "required": [
          "driveId",
          "itemId",
          "versionsJson",
          "versionCount",
          "hasMore"
        ]
