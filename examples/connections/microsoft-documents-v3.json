      "requestSchema": {
        "type": "object",
        "properties": {
          "driveId": {
            "type": "string",
            "enum": [
              "drive"
            ]
          },
          "itemId": {
            "type": "string"
          }
        },
        "required": [
          "driveId",
          "itemId"
        ],
        "additionalProperties": false
