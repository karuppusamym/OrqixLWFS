      "method": "POST",
      "path": "/metadata",
      "requestSchema": {
        "type": "object",
        "properties": {
          "driveId": {
            "type": "string",
            "enum": [
              "drive"
            ]
          },
          "itemId": {
            "type": "string"
          },
          "versionId": {
            "type": "string"
          }
        },
        "required": [
          "driveId",
          "itemId",
          "versionId"
        ],
        "additionalProperties": false
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "driveId": {
            "type": "string"
          },
          "itemId": {
            "type": "string"
          },
          "versionId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "webUrl": {
            "type": "string"
          },
          "eTag": {
            "type": "string"
          },
          "lastModifiedDateTime": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          }
        },
        "required": [
          "driveId",
          "itemId",
          "versionId",
          "name",
          "webUrl",
          "eTag",
          "lastModifiedDateTime",
          "size"
        ],
        "additionalProperties": false
      },
      "successStatuses": [
        200
      ],
      "effectClass": "readOnly",
      "maxTimeoutSeconds": 30,
      "testable": true
    },
