{
  "schemaVersion": "0.1",
  "workflowKey": "document-authoring-review",
  "name": "Review an approved historical document reference",
  "metadata": {
    "description": "Studio document authoring uses exact constrained request choices, stable version mapping and safe runtime provenance.",
    "tags": [
      "documents",
      "approval"
    ]
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "documentDriveId": {
        "type": "string",
        "title": "Read approved document version: driveId",
        "enum": [
          "drive"
        ],
        "description": "Approved document reference."
      },
      "documentItemId": {
        "type": "string",
        "title": "Read approved document version: itemId",
        "enum": [
          "item"
        ],
        "description": "Approved document reference."
      },
      "documentVersionId": {
        "type": "string",
        "title": "Read approved document version: versionId",
        "enum": [
          "1.0"
        ],
        "description": "Approved exact historical version; no latest fallback."
      }
    },
    "required": [
      "documentDriveId",
      "documentItemId",
      "documentVersionId"
    ]
  },
  "inputUi": {
    "order": [
      "documentDriveId",
      "documentItemId",
      "documentVersionId"
    ],
    "widgets": {
      "documentDriveId": "select",
      "documentItemId": "select",
      "documentVersionId": "select"
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "documentName": {
        "type": "string",
        "title": "documentName"
      },
      "documentVersion": {
        "type": "string",
        "title": "documentVersion"
      },
      "documentHash": {
        "type": "string",
        "title": "documentHash"
      }
    }
  },
  "triggers": [
    "manual",
    "api"
  ],
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "label": "Document submitted",
      "config": {}
    },
    {
      "id": "document",
      "type": "http",
      "label": "Read approved document version",
      "config": {
        "connectionRef": "microsoft-documents",
        "operation": "readText",
        "resultMapping": {
          "name": "/name",
          "versionId": "/versionId",
          "text": "/text",
          "contentSha256": "/contentSha256",
          "driveId": "/driveId",
          "itemId": "/itemId",
          "eTag": "/eTag"
        },
        "timeoutSeconds": 30,
        "inputMapping": {
          "driveId": "/input/documentDriveId",
          "itemId": "/input/documentItemId",
          "versionId": "/input/documentVersionId"
        }
      }
    },
    {
      "id": "review",
      "type": "approval",
      "label": "Review document",
      "config": {
        "candidateGroupRef": "managers",
        "rejectReasonRequired": true
      }
    },
    {
      "id": "approved",
      "type": "end",
      "label": "Accepted",
      "config": {
        "businessOutcome": "Document accepted",
        "outcomeKind": "success"
      }
    },
    {
      "id": "rejected",
      "type": "end",
      "label": "Rejected",
      "config": {
        "businessOutcome": "Document rejected",
        "outcomeKind": "rejected"
      }
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "start",
      "to": "document",
      "on": "next"
    },
    {
      "id": "t2",
      "from": "document",
      "to": "review",
      "on": "next"
    },
    {
      "id": "t3",
      "from": "review",
      "to": "approved",
      "on": "approved"
    },
    {
      "id": "t4",
      "from": "review",
      "to": "rejected",
      "on": "rejected"
    }
  ],
  "decisions": [],
  "execution": {
    "maxConcurrentRuns": 500,
    "maxAttempts": 3,
    "retryDelaySeconds": 30
  },
  "security": {
    "selfApproval": "deny"
  },
  "dependencies": {
    "connections": [
      {
        "key": "microsoft-documents",
        "definitionVersion": 3
      }
    ]
  },
  "outputMapping": {
    "documentName": {
      "fieldRef": "/steps/document/name",
      "required": false
    },
    "documentVersion": {
      "fieldRef": "/steps/document/versionId",
      "required": false
    },
    "documentHash": {
      "fieldRef": "/steps/document/contentSha256",
      "required": false
    }
  },
  "uiLayout": {
    "positions": {}
  }
}
