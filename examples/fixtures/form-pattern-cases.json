{
  "description": "Shared cases for the safe form pattern engine (docs/build/S90). Run by the Java engine (FormPatternTest), the browser engine (pattern.test.ts) and, for the accepted patterns, by the native ECMAScript RegExp with the u flag to prove equal semantics.",
  "valid": [
    { "pattern": "^[A-Z]{2}-\\d{4}$", "accept": ["CC-1234", "AB-0000"], "reject": ["cc-1234", "CC-123", "CC-12345", "CC 1234", "", "CC-1234\n"], "example": "AA-0000" },
    { "pattern": "^\\d+$", "accept": ["0", "123456"], "reject": ["", "12a", " 1", "١٢"], "example": "0" },
    { "pattern": "^(red|green|blue)$", "accept": ["red", "blue"], "reject": ["redgreen", "Red", ""], "example": "red" },
    { "pattern": "^(?:ab)*c?$", "accept": ["", "ab", "ababc", "c"], "reject": ["a", "abab c", "cc"], "example": "" },
    { "pattern": "^[^\\s@]+@[^\\s@]+\\.[a-z]{2,10}$", "accept": ["ana@example.com", "a.b@c.io"], "reject": ["ana@example", "ana @x.com", "@x.com", "a@b.c"], "example": "a@a.aa" },
    { "pattern": "^\\w{3,8}$", "accept": ["abc", "A_1b2c3d"], "reject": ["ab", "abcdefghi", "ab-c", "abé"], "example": "000" },
    { "pattern": "^.{0,5}$", "accept": ["", "héllo", "😀😀😀😀😀"], "reject": ["123456", "a\nb", "a\rb"], "example": "" },
    { "pattern": "^[a-c-]+$", "accept": ["a-b-c", "---"], "reject": ["d", ""], "example": "-" },
    { "pattern": "^[-a]$", "accept": ["-", "a"], "reject": ["b", "--"], "example": "-" },
    { "pattern": "^\\$\\d+(\\.\\d{2})?$", "accept": ["$5", "$10.50"], "reject": ["5", "$10.5", "$"], "example": "$0" },
    { "pattern": "^[\\[\\]\\\\]+$", "accept": ["[]", "\\"], "reject": ["a", ""], "example": "[" },
    { "pattern": "^\\S+(\\s\\S+)*$", "accept": ["one", "one two", "one two"], "reject": ["", " one", "one  two", "one "], "example": "a" },
    { "pattern": "^[\\d\\s]+$", "accept": ["1 2", "\t3"], "reject": ["x", ""], "example": "0" },
    { "pattern": "^[^0-9]*$", "accept": ["", "abc", "😀"], "reject": ["a1"], "example": "" },
    { "pattern": "^\\D\\W$", "accept": ["a-", "--"], "reject": ["1-", "aa"], "example": "a " },
    { "pattern": "^(a|ab)(c|bcd)(d*)$", "accept": ["abcd", "acd", "abcdd"], "reject": ["ab", "abd"], "example": "ac" },
    { "pattern": "^😀+x$", "accept": ["😀x", "😀😀x"], "reject": ["x", "😀"], "example": "😀x" },
    { "pattern": "^a{2}b{1,}c{0,1}\\/$", "accept": ["aab/", "aabbbc/"], "reject": ["ab/", "aac/", "aab"], "example": "aab/" },
    { "pattern": "^(a+)+$", "accept": ["a", "aaaa"], "reject": ["", "aab"], "example": "a" },
    { "pattern": "^(a|a)*b$", "accept": ["b", "aab"], "reject": ["aa"], "example": "b" },
    { "pattern": "^(\\w+\\s?)*$", "accept": ["", "word word"], "reject": ["word!"], "example": "" },
    { "pattern": "^$", "accept": [""], "reject": ["a"], "example": "" },
    { "pattern": "^\\^\\$$", "accept": ["^$"], "reject": ["", "^"], "example": "^$" }
  ],
  "invalid": [
    { "pattern": "", "reason": "empty" },
    { "pattern": "[A-Z]+", "reason": "Start the pattern with ^" },
    { "pattern": "^[A-Z]+", "reason": "Start the pattern with ^" },
    { "pattern": "^[A-Z]+\\$", "reason": "Start the pattern with ^" },
    { "pattern": "^a|b$", "reason": "Put alternatives in a group" },
    { "pattern": "^(a)\\1$", "reason": "Backreferences" },
    { "pattern": "^(?=a)a$", "reason": "Lookarounds" },
    { "pattern": "^(?<n>a)$", "reason": "Lookarounds" },
    { "pattern": "^(?i)a$", "reason": "Lookarounds" },
    { "pattern": "^a*?$", "reason": "Lazy" },
    { "pattern": "^a+?$", "reason": "Lazy" },
    { "pattern": "^a**$", "reason": "cannot follow another repeat" },
    { "pattern": "^\\bword$", "reason": "Word boundaries" },
    { "pattern": "^\\p{L}+$", "reason": "Unicode property" },
    { "pattern": "^\\u0041$", "reason": "not supported" },
    { "pattern": "^\\-$", "reason": "not supported" },
    { "pattern": "^a{101}$", "reason": "limited to 100" },
    { "pattern": "^a{5,2}$", "reason": "cannot be larger" },
    { "pattern": "^a{2$", "reason": "repeat counts" },
    { "pattern": "^a{,2}$", "reason": "repeat counts" },
    { "pattern": "^{2}$", "reason": "Nothing to repeat" },
    { "pattern": "^*a$", "reason": "Nothing to repeat" },
    { "pattern": "^a]$", "reason": "literal" },
    { "pattern": "^a}$", "reason": "literal" },
    { "pattern": "^[]$", "reason": "at least one" },
    { "pattern": "^[a-$", "reason": "not closed" },
    { "pattern": "^[z-a]$", "reason": "out of order" },
    { "pattern": "^[\\d-z]$", "reason": "range cannot" },
    { "pattern": "^[a-c-e]$", "reason": "put - first or last" },
    { "pattern": "^[[]$", "reason": "inside a class" },
    { "pattern": "^(a$", "reason": "not closed" },
    { "pattern": "^a)$", "reason": "without a matching" },
    { "pattern": "^a^b$", "reason": "only allowed at the very start" },
    { "pattern": "^a\\", "reason": "Start the pattern with ^" },
    { "pattern": "^a\tb$", "reason": "Control characters" },
    { "pattern": "^((((((((((((((((((((((a))))))))))))))))))))))$", "reason": "nested too deeply" },
    { "pattern": "^((a{100}){100}){100}$", "reason": "too complex" },
    { "pattern": "^(((){100}){100}){100}$", "reason": "too complex" },
    { "pattern": "^[^\\s\\S]$", "reason": "No answer can match" },
    { "pattern": "^aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa$", "reason": "longer than 200" }
  ],
  "slow": [
    { "pattern": "^(a+)+$", "input": "a", "repeat": 3999, "suffix": "!" },
    { "pattern": "^(a|a)*$", "input": "a", "repeat": 3999, "suffix": "!" },
    { "pattern": "^(a|aa)+$", "input": "a", "repeat": 3999, "suffix": "b" },
    { "pattern": "^(.*a){20}$", "input": "a", "repeat": 3999, "suffix": "!" },
    { "pattern": "^(\\w+\\s?)*$", "input": "word ", "repeat": 799, "suffix": "!" },
    { "pattern": "^(x+x+)+y$", "input": "x", "repeat": 3999, "suffix": "" },
    { "pattern": "^([a-z]{1,50}){1,10}$", "input": "a", "repeat": 3999, "suffix": "1" },
    { "pattern": "^(((a*)*)*)*b$", "input": "a", "repeat": 3999, "suffix": "" }
  ]
}
