      "request": {
        "method": "GET",
        "urlPath": "/servicenow/api/now/table/incident",
        "queryParameters": {
          "sysparm_query": { "equalTo": "active=true^assignment_group=0123456789abcdef0123456789abcdef^ORDERBYDESCsys_created_on" },
