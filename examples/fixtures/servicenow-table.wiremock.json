            "close_code": "Solved (Permanently)",
            "close_notes": "Access granted.",
            "correlation_id": "ORQ-1042-raise-1"
          }
        }
      }
    },
    {
      "name": "getIncident not found",
      "priority": 10,
      "request": { "method": "GET", "urlPathPattern": "/servicenow/api/now/table/incident/[0-9a-f]{32}" },
      "response": {
