<?xml version="1.0" encoding="UTF-8"?>
<!-- SYNTHETIC hand-authored fixture (Camunda 7 style DMN 1.3), not a customer export. Hit policy UNIQUE, one numeric input,
     two literal outputs. The middle rule is the bounded range [1000..5000): the importer carries it as the table default
     because the other two rules cover everything else exactly. Boundary values to try: 999.99 / 1000 / 4999.99 / 5000. -->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" xmlns:camunda="http://camunda.org/schema/1.0/dmn" id="approval-definitions" name="Approval level" namespace="urn:orqix:migration-fixture">
  <decision id="approvalLevel" name="Approval level" camunda:historyTimeToLive="P30D">
    <decisionTable id="approvalLevelTable" hitPolicy="UNIQUE">
      <input id="amountColumn" label="Amount (USD)" camunda:inputVariable="amount">
        <inputExpression id="amountExpression" typeRef="number"><text>amount</text></inputExpression>
      </input>
      <output id="levelColumn" label="Approval level" name="level" typeRef="string" />
      <output id="approversColumn" label="Approvers" name="approvers" typeRef="integer" />
      <rule id="rulePetty">
        <inputEntry id="pettyAmount"><text>&lt; 1000</text></inputEntry>
        <outputEntry id="pettyLevel"><text>"auto"</text></outputEntry>
        <outputEntry id="pettyApprovers"><text>0</text></outputEntry>
      </rule>
      <rule id="ruleStandard">
        <inputEntry id="standardAmount"><text>[1000..5000)</text></inputEntry>
        <outputEntry id="standardLevel"><text>"manager"</text></outputEntry>
        <outputEntry id="standardApprovers"><text>1</text></outputEntry>
      </rule>
      <rule id="ruleLarge">
        <inputEntry id="largeAmount"><text>&gt;= 5000</text></inputEntry>
        <outputEntry id="largeLevel"><text>"finance"</text></outputEntry>
        <outputEntry id="largeApprovers"><text>2</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
