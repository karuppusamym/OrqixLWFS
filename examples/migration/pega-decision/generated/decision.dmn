<definitions xmlns="http://www.omg.org/spec/DMN/20151101/dmn.xsd" id="pegaDefinitions" name="Synthetic purchase routing" namespace="urn:orqix:pega-snapshot"><decision id="PurchaseRoute" name="Synthetic purchase routing"><decisionTable id="pegaTable" hitPolicy="FIRST"><input id="pegaInput" label="Amount"><inputExpression id="pegaExpression" typeRef="double"><text>Amount</text></inputExpression></input><output id="pegaOutput" name="result" typeRef="string" /><rule id="pegaRow1"><inputEntry id="input0"><text>&gt;= 10000</text></inputEntry><outputEntry id="output0"><text>"Director"</text></outputEntry></rule><rule id="pegaRow2"><inputEntry id="input1"><text>&gt;= 5000</text></inputEntry><outputEntry id="output1"><text>"Finance"</text></outputEntry></rule><rule id="pegaRow3"><inputEntry id="input2"><text>-</text></inputEntry><outputEntry id="output2"><text>"Standard"</text></outputEntry></rule></decisionTable></decision></definitions>