{
  "schemaVersion": "0.1",
  "workflowKey": "order-payment-first",
  "name": "Hold an order until it is paid, cancelled or too old",
  "metadata": {
    "description": "An order waits for whichever comes first: the payment-received message for its order number, the customer-cancelled signal, or seven days without either. The step that waits is one 'Wait for the first' step with three branches (docs/build/S139).",
    "tags": [
      "message",
      "signal",
      "timer",
      "waitForFirst"
    ]
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "orderNumber",
      "customerName"
    ],
    "properties": {
      "orderNumber": {
        "type": "string",
        "title": "Order number",
        "description": "The number the payment system will quote when the payment arrives.",
        "minLength": 3,
        "maxLength": 40
      },
      "customerName": {
        "type": "string",
        "title": "Customer",
        "description": "Who placed the order.",
        "minLength": 1,
        "maxLength": 100
      }
    }
  },
  "inputUi": {
    "order": [
      "orderNumber",
      "customerName"
    ],
    "widgets": {}
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "paymentReference": {
        "type": "string",
        "title": "Payment reference"
      }
    }
  },
  "triggers": [
    "manual",
    "api"
  ],
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "label": "Order placed",
      "config": {}
    },
    {
      "id": "waitFirst",
      "type": "waitForFirst",
      "label": "Wait for payment or cancellation",
      "config": {
        "branches": [
          {
            "id": "paid",
            "label": "Payment received",
            "kind": "message",
            "message": "payment-received",
            "correlationField": "/input/orderNumber",
            "payload": [
              {
                "name": "paymentReference",
                "type": "string",
                "title": "Payment reference",
                "required": true
              },
              {
                "name": "amountPaid",
                "type": "number",
                "title": "Amount paid"
              }
            ]
          },
          {
            "id": "withdrawn",
            "label": "Customer cancelled",
            "kind": "signal",
            "signal": "customer-cancelled"
          },
          {
            "id": "tooOld",
            "label": "Seven days passed",
            "kind": "timer",
            "after": "P7D"
          }
        ]
      }
    },
    {
      "id": "notifyPaid",
      "type": "notification",
      "label": "Tell requester the payment arrived",
      "config": {
        "channel": "inApp",
        "recipient": "initiator",
        "message": "The payment for your order arrived. It is now being fulfilled."
      }
    },
    {
      "id": "fulfilled",
      "type": "end",
      "label": "Order paid",
      "config": {
        "businessOutcome": "Order paid",
        "outcomeKind": "success"
      }
    },
    {
      "id": "notifyCancelled",
      "type": "notification",
      "label": "Tell requester the order was cancelled",
      "config": {
        "channel": "inApp",
        "recipient": "initiator",
        "message": "The order was cancelled or not paid within seven days."
      }
    },
    {
      "id": "cancelled",
      "type": "end",
      "label": "Cancelled, no payment",
      "config": {
        "businessOutcome": "Cancelled no payment",
        "outcomeKind": "rejected"
      }
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "start",
      "to": "waitFirst",
      "on": "next"
    },
    {
      "id": "t2",
      "from": "waitFirst",
      "to": "notifyPaid",
      "on": "branch",
      "branch": "paid",
      "label": "Payment arrived"
    },
    {
      "id": "t3",
      "from": "waitFirst",
      "to": "notifyCancelled",
      "on": "branch",
      "branch": "withdrawn",
      "label": "Customer cancelled"
    },
    {
      "id": "t6",
      "from": "waitFirst",
      "to": "notifyCancelled",
      "on": "branch",
      "branch": "tooOld",
      "label": "No payment in 7 days"
    },
    {
      "id": "t4",
      "from": "notifyPaid",
      "to": "fulfilled",
      "on": "next"
    },
    {
      "id": "t5",
      "from": "notifyCancelled",
      "to": "cancelled",
      "on": "next"
    }
  ],
  "decisions": [],
  "execution": {
    "maxConcurrentRuns": 100,
    "maxAttempts": 3,
    "retryDelaySeconds": 30
  },
  "security": {
    "selfApproval": "deny"
  },
  "dependencies": {
    "connections": []
  },
  "outputMapping": {
    "paymentReference": {
      "fieldRef": "/steps/waitFirst/paymentReference",
      "required": false
    }
  },
  "uiLayout": {
    "positions": {
      "start": {
        "x": 80,
        "y": 200
      },
      "notifyPaid": {
        "x": 600,
        "y": 200
      },
      "fulfilled": {
        "x": 860,
        "y": 200
      },
      "notifyCancelled": {
        "x": 600,
        "y": 420
      },
      "cancelled": {
        "x": 860,
        "y": 420
      },
      "waitFirst": {
        "x": 320,
        "y": 200
      }
    },
    "viewport": {
      "x": 0,
      "y": 0,
      "zoom": 0.8
    }
  }
}
