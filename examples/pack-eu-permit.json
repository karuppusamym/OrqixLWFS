{
  "schemaVersion": "0.1",
  "workflowKey": "permit-eu",
  "name": "Building permit (European Union)",
  "metadata": {
    "description": "European Union building permit for a municipal office. A clerk checks completeness, planning scrutinises the plans, then fire and heritage reviews run only when the rules ask for them (inclusive split), and the permit authority decides within three months or the case escalates. Due dates count office hours and public holidays. Fire safety review from 22 m (high-rise threshold in German state building codes) or for assembly use; heritage review for listed buildings; escalation after three months, the usual statutory decision period. Shown in German as the EU second language; adapt to the member state. Illustrative regional template, not a regulatory-compliant product: thresholds, holiday lists and document names are placeholders for your compliance function to confirm.",
    "tags": [
      "pack:public-sector",
      "region:eu",
      "template:permit",
      "owner:Municipal permit office",
      "illustrative",
      "lang:de"
    ]
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "applicantName",
      "buildingUse",
      "floors",
      "height",
      "parcel",
      "floorArea",
      "listedBuilding"
    ],
    "properties": {
      "applicantName": {
        "type": "string",
        "title": "Applicant name / Name des Bauherrn",
        "minLength": 1,
        "maxLength": 200
      },
      "parcel": {
        "type": "string",
        "title": "Parcel (Flurstück) / Flurstück",
        "minLength": 1,
        "maxLength": 60
      },
      "district": {
        "type": "string",
        "title": "Municipality district / Gemarkung",
        "minLength": 1,
        "maxLength": 60
      },
      "buildingUse": {
        "type": "string",
        "title": "Building use / Nutzung",
        "enum": [
          "Residential",
          "Commercial",
          "Mixed use",
          "Industrial",
          "Assembly"
        ]
      },
      "floorArea": {
        "type": "number",
        "title": "Gross floor area (m²) / Bruttogrundfläche (m²)",
        "minimum": 1,
        "maximum": 1000000,
        "multipleOf": 0.01
      },
      "floors": {
        "type": "integer",
        "title": "Floors / Geschosse",
        "minimum": 1,
        "maximum": 60
      },
      "height": {
        "type": "number",
        "title": "Building height (m) / Gebäudehöhe (m)",
        "minimum": 1,
        "maximum": 300,
        "multipleOf": 0.01
      },
      "listedBuilding": {
        "type": "boolean",
        "title": "Listed building or heritage area / Denkmal oder Denkmalbereich"
      }
    }
  },
  "inputUi": {
    "order": [
      "applicantName",
      "parcel",
      "district",
      "buildingUse",
      "floorArea",
      "floors",
      "height",
      "listedBuilding"
    ],
    "widgets": {
      "buildingUse": "select",
      "floorArea": "number",
      "height": "number",
      "listedBuilding": "checkbox"
    },
    "submitLabel": "Submit application / Antrag einreichen",
    "layout": {
      "sections": [
        {
          "id": "applicant",
          "title": "Applicant / Bauherr",
          "columns": 2,
          "fields": [
            "applicantName",
            "parcel",
            "district"
          ]
        },
        {
          "id": "building",
          "title": "Building / Gebäude",
          "columns": 2,
          "fields": [
            "buildingUse",
            "floorArea",
            "floors",
            "height",
            "listedBuilding"
          ]
        }
      ]
    }
  },
  "outputSchema": {
