      "type": "notification",
      "label": "Tell requester the vendor is onboarded",
      "config": {
        "channel": "inApp",
        "recipient": "initiator",
        "message": "The vendor was onboarded. / Der Lieferant wurde aufgenommen."
      }
    },
    {
      "id": "notifyRejected",
      "type": "notification",
      "label": "Tell requester the vendor was rejected",
      "config": {
        "channel": "inApp",
        "recipient": "initiator",
        "message": "The vendor was rejected. Open the request to see the reason. / Der Lieferant wurde abgelehnt. Den Grund finden Sie im Antrag."
      }
    },
    {
      "id": "onboarded",
      "type": "end",
      "label": "Onboarded",
      "config": {
        "businessOutcome": "Onboarded",
        "outcomeKind": "success"
      }
    },
    {
      "id": "rejected",
      "type": "end",
      "label": "Rejected",
      "config": {
        "businessOutcome": "Rejected",
        "outcomeKind": "rejected"
      }
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "start",
      "to": "risk",
      "on": "next"
    },
    {
      "id": "t2",
      "from": "risk",
      "to": "split",
      "on": "next"
    },
    {
      "id": "t3",
      "from": "split",
      "to": "diligence",
      "on": "next"
    },
    {
      "id": "t4",
      "from": "split",
      "to": "bank",
      "on": "next"
    },
    {
      "id": "t5",
      "from": "diligence",
      "to": "join",
      "on": "approved"
    },
    {
      "id": "t6",
      "from": "diligence",
      "to": "notifyRejected",
      "on": "rejected"
    },
    {
      "id": "t7",
      "from": "bank",
      "to": "join",
      "on": "approved"
    },
    {
      "id": "t8",
      "from": "bank",
      "to": "notifyRejected",
      "on": "rejected"
    },
    {
      "id": "t9",
      "from": "join",
      "to": "privacyRoute",
      "on": "next"
    },
    {
      "id": "t10",
      "from": "privacyRoute",
      "to": "privacy",
      "on": "condition",
      "label": "Processes personal data",
      "condition": {
        "fieldRef": "/input/personalData",
        "operator": "eq",
        "value": true
      }
    },
    {
      "id": "t11",
      "from": "privacyRoute",
      "to": "riskRoute",
      "on": "default",
      "label": "No personal data"
    },
    {
      "id": "t12",
      "from": "privacy",
      "to": "riskRoute",
      "on": "approved"
    },
    {
      "id": "t13",
      "from": "privacy",
      "to": "notifyRejected",
      "on": "rejected"
    },
    {
      "id": "t14",
      "from": "riskRoute",
      "to": "compliance",
      "on": "condition",
      "label": "Conflict declared or EUR 250,000 or more",
      "condition": {
        "fieldRef": "/steps/risk/band",
        "operator": "eq",
        "value": "high"
      }
    },
    {
      "id": "t15",
      "from": "riskRoute",
      "to": "notifyApproved",
      "on": "default",
      "label": "Standard risk"
    },
    {
      "id": "t16",
      "from": "compliance",
      "to": "notifyApproved",
      "on": "approved"
    },
    {
      "id": "t17",
      "from": "compliance",
      "to": "notifyRejected",
      "on": "rejected"
    },
    {
      "id": "t18",
      "from": "notifyApproved",
      "to": "onboarded",
      "on": "next"
    },
    {
      "id": "t19",
      "from": "notifyRejected",
      "to": "rejected",
      "on": "next"
    }
  ],
  "decisions": [
    {
      "key": "vendor-risk",
      "version": 1,
      "hitPolicy": "FIRST",
      "rows": [
        {
          "when": {
            "any": [
              {
                "fieldRef": "/input/conflictOfInterest",
                "operator": "eq",
                "value": true
              },
              {
                "fieldRef": "/input/annualSpend",
                "operator": "gte",
                "value": 250000
              }
            ]
          },
          "then": {
            "band": "high"
          }
        }
      ],
      "default": {
        "band": "standard"
      }
    }
  ],
  "execution": {
    "maxConcurrentRuns": 200,
    "maxAttempts": 3,
    "retryDelaySeconds": 30
  },
  "security": {
    "selfApproval": "deny"
  },
  "dependencies": {
    "connections": []
  },
  "outputMapping": {
    "riskBand": {
      "fieldRef": "/steps/risk/band",
      "required": true
    },
    "diligenceBy": {
      "fieldRef": "/steps/diligence/decidedBy",
      "required": false
    }
  },
