{
  "schemaVersion": "0.1",
  "workflowKey": "vendor-onboarding-eu",
  "name": "Vendor onboarding (European Union)",
  "metadata": {
    "description": "European Union vendor onboarding in EUR without any connection. Procurement due diligence and bank-detail verification run in parallel; vendors that process personal data get a privacy review (GDPR Article 28 (data processing agreement)); a declared conflict of interest or spend of EUR 250,000 or more needs compliance approval. The VAT identification number is format-checked on the form. Due dates count European Union office hours and public holidays. Check the VAT number in VIES and screen against EU sanctions lists during due diligence. Illustrative regional template, not a regulatory-compliant product: thresholds, holiday lists and document names are placeholders for your compliance function to confirm.",
    "tags": [
      "pack:shared-services",
      "region:eu",
      "template:vendor-onboarding",
      "owner:Procurement operations",
      "illustrative",
      "lang:de"
    ]
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "vendorName",
      "taxId",
      "category",
      "annualSpend",
      "personalData",
      "conflictOfInterest"
    ],
    "properties": {
      "vendorName": {
        "type": "string",
        "title": "Vendor legal name / Rechtlicher Name des Lieferanten",
        "minLength": 1,
        "maxLength": 200
      },
      "taxId": {
        "type": "string",
        "title": "VAT identification number / Umsatzsteuer-Identifikationsnummer",
        "minLength": 4,
        "maxLength": 20,
        "pattern": "^[A-Z]{2}[A-Za-z0-9]{2,13}$",
        "patternMessage": "Enter a VAT number starting with the country code, for example DE123456789."
      },
      "category": {
        "type": "string",
        "title": "Category / Kategorie",
        "enum": [
          "Goods",
          "Services",
          "IT and software",
          "Works and construction",
          "Professional services"
        ]
      },
      "annualSpend": {
        "type": "number",
        "title": "Expected annual spend (EUR) / Erwartetes Jahresvolumen (EUR)",
        "minimum": 1,
        "maximum": 10000000000,
        "multipleOf": 0.01
      },
      "personalData": {
        "type": "boolean",
        "title": "Vendor will process personal data / Lieferant verarbeitet personenbezogene Daten"
      },
      "conflictOfInterest": {
        "type": "boolean",
        "title": "Possible conflict of interest declared / Möglicher Interessenkonflikt angegeben"
      }
    }
  },
  "inputUi": {
    "order": [
      "vendorName",
      "taxId",
      "category",
      "annualSpend",
      "personalData",
      "conflictOfInterest"
    ],
    "widgets": {
      "category": "select",
      "annualSpend": "number",
      "personalData": "checkbox",
      "conflictOfInterest": "checkbox"
    },
    "submitLabel": "Submit vendor / Lieferant einreichen",
    "layout": {
      "sections": [
        {
          "id": "vendor",
          "title": "Vendor / Lieferant",
          "columns": 2,
          "fields": [
            "vendorName",
            "taxId",
            "category",
            "annualSpend"
          ]
        },
        {
          "id": "risk",
          "title": "Risk / Risiko",
          "columns": 1,
          "fields": [
            "personalData",
            "conflictOfInterest"
          ]
        }
      ]
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "riskBand": {
        "type": "string",
        "title": "Risk band"
      },
      "diligenceBy": {
        "type": "string",
        "title": "Due diligence by"
      }
    }
  },
  "triggers": [
    "manual",
    "api"
  ],
  "nodes": [
