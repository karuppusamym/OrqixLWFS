      "to": "eligibility",
      "on": "next"
    },
    {
      "id": "t2",
      "from": "eligibility",
      "to": "eligibleRoute",
      "on": "next"
    },
    {
      "id": "t3",
      "from": "eligibleRoute",
      "to": "notifyIneligible",
      "on": "condition",
      "label": "Size or registration rule not met",
      "condition": {
        "fieldRef": "/steps/eligibility/eligible",
        "operator": "eq",
        "value": false
      }
    },
    {
      "id": "t4",
      "from": "eligibleRoute",
      "to": "fieldVerification",
      "on": "default",
      "label": "Eligible"
    },
    {
