{
  "schemaVersion": "0.1",
  "workflowKey": "group-loan-in",
  "name": "Group loan approval (India)",
  "metadata": {
    "description": "India cooperative and microfinance group loan in INR. Rules check group size (Joint liability group - JLG 4 to 10 members; Self-help group - SHG 10 to 20 members) and registration; a field officer verifies the group, then the branch manager approves, or a two-member credit committee when the total is INR 10 lakh or more. Due dates count India banking hours and holidays. JLG of 4 to 10 and SHG of 10 to 20 members after compulsory group training, in line with NABARD and RBI microfinance practice. Illustrative regional template, not a regulatory-compliant product: thresholds, holiday lists and document names are placeholders for your compliance function to confirm.",
    "tags": [
      "pack:banking-mfi",
      "region:india",
      "template:group-loan",
      "owner:Microfinance operations",
      "illustrative",
      "lang:hi"
    ]
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "groupName",
      "groupType",
      "registered",
      "loanPurpose",
      "members"
    ],
    "properties": {
      "groupName": {
        "type": "string",
        "title": "Group name / समूह का नाम",
        "minLength": 1,
        "maxLength": 200
      },
      "groupType": {
        "type": "string",
        "title": "Group type / समूह प्रकार",
        "enum": [
          "Joint liability group - JLG",
          "Self-help group - SHG"
        ]
      },
      "registered": {
        "type": "boolean",
        "title": "Compulsory group training completed / अनिवार्य समूह प्रशिक्षण पूरा"
      },
      "meetingDate": {
        "type": "string",
        "format": "date",
        "title": "Group meeting date / समूह बैठक की तिथि"
      },
      "loanPurpose": {
        "type": "string",
        "title": "Loan purpose / ऋण का उद्देश्य",
        "enum": [
          "Income generation",
          "Agriculture and allied",
          "Small trade",
          "Education",
          "Housing repair"
        ]
      },
      "members": {
        "type": "array",
        "title": "Members / सदस्य",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "memberName",
            "amount"
          ],
          "properties": {
            "memberName": {
              "type": "string",
              "title": "Member name / सदस्य का नाम",
              "minLength": 1,
              "maxLength": 200
            },
            "memberRef": {
              "type": "string",
              "title": "Member reference / सदस्य संदर्भ",
              "minLength": 0,
              "maxLength": 40
            },
            "amount": {
              "type": "number",
              "title": "Amount (INR) / राशि (₹)",
              "minimum": 1,
              "maximum": 100000000,
              "multipleOf": 0.01
            }
          }
        }
      }
    }
  },
  "inputUi": {
    "order": [
      "groupName",
      "groupType",
      "registered",
      "meetingDate",
      "loanPurpose",
      "members"
    ],
    "widgets": {
      "groupType": "select",
      "registered": "checkbox",
      "loanPurpose": "select"
    },
    "submitLabel": "Submit group loan / समूह ऋण जमा करें",
    "layout": {
      "sections": [
        {
          "id": "group",
          "title": "Group / समूह",
          "columns": 2,
          "fields": [
            "groupName",
            "groupType",
            "registered",
            "meetingDate",
            "loanPurpose"
          ]
        },
        {
          "id": "members",
          "title": "Members / सदस्य",
          "columns": 1,
          "fields": [
            "members"
          ]
        }
      ]
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "memberCount": {
        "type": "integer",
        "title": "Members"
      },
      "totalAmount": {
        "type": "number",
        "title": "Total amount (INR)"
      },
      "verifiedBy": {
        "type": "string",
        "title": "Verified by"
      }
    }
  },
