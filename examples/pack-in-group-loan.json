  "decisions": [
    {
      "key": "group-eligibility",
      "version": 1,
      "hitPolicy": "FIRST",
      "rows": [
        {
          "when": {
            "fieldRef": "/input/registered",
            "operator": "eq",
            "value": false
          },
          "then": {
            "eligible": false
          }
        },
        {
          "when": {
            "all": [
              {
                "fieldRef": "/input/groupType",
                "operator": "eq",
                "value": "Joint liability group - JLG"
              },
              {
                "fieldRef": "/input/members/count",
                "operator": "lt",
                "value": 4
              }
            ]
          },
          "then": {
            "eligible": false
          }
        },
        {
          "when": {
            "all": [
              {
                "fieldRef": "/input/groupType",
                "operator": "eq",
                "value": "Joint liability group - JLG"
              },
              {
                "fieldRef": "/input/members/count",
                "operator": "gt",
                "value": 10
              }
            ]
          },
          "then": {
            "eligible": false
          }
        },
        {
          "when": {
            "all": [
              {
                "fieldRef": "/input/groupType",
                "operator": "eq",
                "value": "Self-help group - SHG"
              },
              {
                "fieldRef": "/input/members/count",
                "operator": "lt",
                "value": 10
              }
            ]
          },
          "then": {
            "eligible": false
          }
        },
        {
          "when": {
            "all": [
              {
                "fieldRef": "/input/groupType",
                "operator": "eq",
                "value": "Self-help group - SHG"
              },
              {
                "fieldRef": "/input/members/count",
                "operator": "gt",
                "value": 20
              }
            ]
          },
          "then": {
            "eligible": false
          }
        }
      ],
      "default": {
        "eligible": true
      }
    },
    {
      "key": "group-level",
      "version": 1,
      "hitPolicy": "FIRST",
      "rows": [
        {
          "when": {
            "fieldRef": "/input/members/sum/amount",
            "operator": "gte",
            "value": 1000000
          },
          "then": {
            "level": "committee"
          }
        }
      ],
      "default": {
        "level": "branch"
      }
    }
  ],
  "execution": {
    "maxConcurrentRuns": 200,
    "maxAttempts": 3,
    "retryDelaySeconds": 30
  },
  "security": {
    "selfApproval": "deny"
  },
