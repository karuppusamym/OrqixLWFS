{
  "schemaVersion": "0.1",
  "workflowKey": "kyc-refresh-in",
  "name": "KYC refresh (India)",
  "metadata": {
    "description": "India KYC refresh. Extends KYC periodic review (same customerName, customerType, kyc-analysts and reviewedBy, plus risk rating and changed-details answers) with a risk-based path: low risk with no change is accepted on self-declaration, medium risk or changed details get an analyst re-review, high risk gets re-review and enhanced due diligence together, escalating after five days. Next refresh in 2, 8 or 10 years. Periodic updation every 2, 8 or 10 years by risk, with self-declaration when nothing changed, as the RBI KYC Master Direction describes. Illustrative regional template, not a regulatory-compliant product: thresholds, holiday lists and document names are placeholders for your compliance function to confirm.",
    "tags": [
      "pack:banking-mfi",
      "region:india",
      "template:kyc-refresh",
      "owner:KYC operations",
      "illustrative",
      "lang:hi"
    ]
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "customerName",
      "customerType",
      "riskRating",
      "detailsChanged"
    ],
    "properties": {
      "customerName": {
        "type": "string",
        "title": "Customer name / ग्राहक का नाम",
        "minLength": 1,
        "maxLength": 200
      },
      "customerType": {
        "type": "string",
        "title": "Customer type / ग्राहक प्रकार",
        "enum": [
          "individual",
          "corporate"
        ]
      },
      "riskRating": {
        "type": "string",
        "title": "Risk rating / जोखिम श्रेणी",
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "detailsChanged": {
        "type": "boolean",
        "title": "KYC details changed since the last update / पिछले अद्यतन के बाद KYC विवरण बदले हैं"
      },
      "idDocument": {
        "type": "string",
        "title": "Officially valid document / आधिकारिक रूप से मान्य दस्तावेज़",
        "enum": [
          "Aadhaar (offline XML or masked copy)",
          "Passport",
          "Voter ID",
          "Driving licence",
          "NREGA job card",
          "PAN (with another OVD)"
        ]
      },
      "lastUpdated": {
        "type": "string",
        "format": "date",
        "title": "Last KYC update / पिछला KYC अद्यतन"
      }
    }
  },
  "inputUi": {
    "order": [
      "customerName",
      "customerType",
      "riskRating",
      "detailsChanged",
      "idDocument",
      "lastUpdated"
    ],
    "widgets": {
      "customerType": "radio",
      "riskRating": "radio",
      "detailsChanged": "checkbox",
      "idDocument": "select"
    },
    "submitLabel": "Submit KYC refresh / पुनः KYC जमा करें",
    "layout": {
      "sections": [
        {
          "id": "customer",
          "title": "Customer / ग्राहक",
          "columns": 2,
          "fields": [
            "customerName",
            "customerType",
            "riskRating"
          ]
        },
        {
          "id": "refresh",
          "title": "Refresh / पुनः KYC",
          "columns": 2,
          "fields": [
            "detailsChanged",
            "idDocument",
            "lastUpdated"
          ]
        }
      ]
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "reviewedBy": {
        "type": "string",
        "title": "Reviewed by"
      },
      "refreshIntervalYears": {
        "type": "integer",
        "title": "Next refresh in years"
      }
    }
  },
  "triggers": [
    "manual",
    "api"
  ],
