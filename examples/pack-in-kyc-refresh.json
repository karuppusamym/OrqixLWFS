  "transitions": [
    {
      "id": "t1",
      "from": "start",
      "to": "interval",
      "on": "next"
    },
    {
      "id": "t2",
      "from": "interval",
      "to": "path",
      "on": "next"
    },
    {
      "id": "t3",
      "from": "path",
      "to": "pathRoute",
      "on": "next"
    },
    {
      "id": "t4",
      "from": "pathRoute",
      "to": "eddSplit",
      "on": "condition",
      "label": "High risk",
      "condition": {
        "fieldRef": "/steps/path/route",
        "operator": "eq",
        "value": "edd"
      }
    },
    {
      "id": "t5",
      "from": "pathRoute",
      "to": "notifySelf",
      "on": "condition",
      "label": "Low risk, nothing changed",
      "condition": {
        "fieldRef": "/steps/path/route",
        "operator": "eq",
        "value": "selfDeclaration"
      }
    },
    {
      "id": "t6",
      "from": "pathRoute",
      "to": "review",
      "on": "default",
      "label": "Medium risk or details changed"
    },
    {
      "id": "t7",
      "from": "notifySelf",
      "to": "refreshed",
      "on": "next"
    },
    {
      "id": "t8",
      "from": "review",
      "to": "notifyDone",
      "on": "approved"
    },
    {
      "id": "t9",
      "from": "review",
      "to": "notifyRestricted",
      "on": "rejected"
    },
    {
      "id": "t10",
      "from": "eddSplit",
      "to": "eddReview",
      "on": "next"
    },
    {
      "id": "t11",
      "from": "eddSplit",
      "to": "edd",
      "on": "next"
    },
    {
      "id": "t12",
      "from": "eddReview",
      "to": "eddJoin",
      "on": "approved"
    },
    {
      "id": "t13",
      "from": "eddReview",
      "to": "notifyRestricted",
      "on": "rejected"
    },
    {
      "id": "t14",
      "from": "edd",
      "to": "eddDone",
      "on": "approved"
    },
    {
      "id": "t15",
      "from": "edd",
      "to": "notifyRestricted",
      "on": "rejected"
    },
    {
      "id": "t16",
      "from": "edd",
      "to": "escalation",
      "on": "timedOut",
      "label": "Not decided in 5 days"
    },
    {
      "id": "t17",
      "from": "escalation",
      "to": "eddDone",
      "on": "approved"
    },
    {
      "id": "t18",
      "from": "eddDone",
      "to": "eddJoin",
      "on": "next"
    },
    {
      "id": "t19",
      "from": "escalation",
      "to": "notifyRestricted",
      "on": "rejected"
    },
    {
      "id": "t20",
      "from": "eddJoin",
      "to": "notifyDone",
      "on": "next"
    },
    {
      "id": "t21",
      "from": "notifyDone",
      "to": "refreshed",
      "on": "next"
    },
    {
      "id": "t22",
      "from": "notifyRestricted",
      "to": "restricted",
      "on": "next"
    }
  ],
  "decisions": [
    {
      "key": "refresh-interval",
      "version": 1,
      "hitPolicy": "FIRST",
      "rows": [
        {
          "when": {
            "fieldRef": "/input/riskRating",
            "operator": "eq",
            "value": "high"
          },
          "then": {
            "intervalYears": 2
          }
        },
        {
          "when": {
            "fieldRef": "/input/riskRating",
            "operator": "eq",
            "value": "low"
          },
          "then": {
            "intervalYears": 10
          }
        }
      ],
      "default": {
        "intervalYears": 8
      }
    },
    {
      "key": "refresh-path",
      "version": 1,
      "hitPolicy": "FIRST",
      "rows": [
        {
          "when": {
            "fieldRef": "/input/riskRating",
            "operator": "eq",
            "value": "high"
          },
          "then": {
            "route": "edd"
          }
        },
        {
          "when": {
            "all": [
              {
                "fieldRef": "/input/detailsChanged",
                "operator": "eq",
                "value": true
              },
              {
                "fieldRef": "/input/riskRating",
                "operator": "ne",
                "value": "high"
              }
            ]
          },
          "then": {
            "route": "review"
          }
        },
        {
          "when": {
            "fieldRef": "/input/riskRating",
            "operator": "eq",
            "value": "low"
          },
          "then": {
            "route": "selfDeclaration"
          }
        }
      ],
      "default": {
        "route": "review"
      }
    }
  ],
  "execution": {
    "maxConcurrentRuns": 200,
    "maxAttempts": 3,
    "retryDelaySeconds": 30
  },
  "security": {
