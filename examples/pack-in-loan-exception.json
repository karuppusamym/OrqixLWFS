{
  "schemaVersion": "0.1",
  "workflowKey": "loan-exception-in",
  "name": "Loan exception approval (India)",
  "metadata": {
    "description": "India loan exception approval in INR. A loan that breaks credit policy goes to the branch manager, then by amount to the credit head (from INR 25 lakh) or a two-member credit committee (from INR 1 crore). Related-party loans also need compliance. Due dates count India banking hours and public holidays. Deviation limits follow a delegation of financial powers; loans to directors and their relatives need board-level clearance. Illustrative regional template, not a regulatory-compliant product: thresholds, holiday lists and document names are placeholders for your compliance function to confirm.",
    "tags": [
      "pack:banking-mfi",
      "region:india",
      "template:loan-exception",
      "owner:Credit operations",
      "illustrative",
      "lang:hi"
    ]
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "loanReference",
      "borrowerSegment",
      "amount",
      "exceptionType",
      "exceptionDetail",
      "relatedParty"
    ],
    "properties": {
      "loanReference": {
        "type": "string",
        "title": "Loan reference / ऋण संदर्भ",
        "minLength": 3,
        "maxLength": 30,
        "pattern": "^[A-Za-z0-9-]{3,30}$",
        "patternMessage": "Use 3 to 30 letters, digits and dashes, for example LN-2026-0042."
      },
      "borrowerSegment": {
        "type": "string",
        "title": "Borrower segment / उधारकर्ता श्रेणी",
        "enum": [
          "Individual",
          "MSME",
          "Agriculture - Kisan Credit Card",
          "Housing"
        ]
      },
      "amount": {
        "type": "number",
        "title": "Loan amount (INR) / ऋण राशि (₹)",
        "minimum": 1,
        "maximum": 10000000000,
        "multipleOf": 0.01
      },
      "exceptionType": {
        "type": "string",
        "title": "Policy exception / नीति अपवाद",
        "enum": [
          "Rate concession",
          "Tenor beyond policy",
          "FOIR above policy",
          "Collateral shortfall",
          "Credit bureau score below cut-off",
          "Documentation deferral"
        ]
      },
      "exceptionDetail": {
        "type": "string",
        "title": "What breaks policy, and why accept it / कौन सी नीति टूटती है, और क्यों स्वीकारें",
        "minLength": 10,
        "maxLength": 2000
      },
      "mitigants": {
        "type": "string",
        "title": "Mitigants / जोखिम कम करने के उपाय",
        "minLength": 0,
        "maxLength": 2000
      },
      "relatedParty": {
        "type": "boolean",
        "title": "Borrower is an insider or related party / उधारकर्ता अंदरूनी व्यक्ति या संबंधित पक्ष है"
      }
    }
  },
  "inputUi": {
    "order": [
      "loanReference",
      "borrowerSegment",
      "amount",
      "exceptionType",
      "exceptionDetail",
      "mitigants",
      "relatedParty"
