      "amount": "number",
      "exceptionType": "select",
      "exceptionDetail": "textarea",
      "mitigants": "textarea",
      "relatedParty": "checkbox"
    },
    "submitLabel": "Submit exception / अपवाद जमा करें",
    "layout": {
      "sections": [
        {
          "id": "loan",
          "title": "Loan / ऋण",
          "columns": 2,
          "fields": [
            "loanReference",
            "borrowerSegment",
