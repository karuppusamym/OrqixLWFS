      "to": "notifyRejected",
      "on": "rejected"
    },
    {
      "id": "t9",
      "from": "levelRoute",
      "to": "committee",
      "on": "condition",
      "label": "INR 1 crore or more",
      "condition": {
        "fieldRef": "/steps/level/level",
        "operator": "eq",
        "value": "committee"
      }
    },
    {
      "id": "t10",
      "from": "levelRoute",
      "to": "creditHead",
      "on": "condition",
      "label": "INR 25 lakh or more",
      "condition": {
        "fieldRef": "/steps/level/level",
        "operator": "eq",
        "value": "creditHead"
      }
    },
    {
      "id": "t11",
      "from": "levelRoute",
      "to": "notifyApproved",
      "on": "default",
      "label": "Within branch powers"
    },
    {
      "id": "t12",
      "from": "creditHead",
      "to": "notifyApproved",
      "on": "approved"
    },
    {
      "id": "t13",
      "from": "creditHead",
      "to": "notifyRejected",
      "on": "rejected"
    },
    {
      "id": "t14",
      "from": "committee",
      "to": "notifyApproved",
      "on": "approved"
    },
    {
      "id": "t15",
      "from": "committee",
      "to": "notifyRejected",
      "on": "rejected"
    },
    {
      "id": "t16",
      "from": "notifyApproved",
      "to": "approved",
      "on": "next"
    },
    {
      "id": "t17",
      "from": "notifyRejected",
      "to": "rejected",
      "on": "next"
    }
  ],
  "decisions": [
    {
      "key": "exception-level",
      "version": 1,
      "hitPolicy": "FIRST",
      "rows": [
        {
          "when": {
            "fieldRef": "/input/amount",
            "operator": "gte",
            "value": 10000000
          },
          "then": {
            "level": "committee"
          }
        },
        {
          "when": {
            "fieldRef": "/input/amount",
            "operator": "gte",
            "value": 2500000
          },
          "then": {
            "level": "creditHead"
          }
        }
      ],
      "default": {
        "level": "branch"
      }
    }
  ],
  "execution": {
    "maxConcurrentRuns": 200,
    "maxAttempts": 3,
    "retryDelaySeconds": 30
  },
  "security": {
    "selfApproval": "deny"
  },
  "dependencies": {
    "connections": []
  },
  "outputMapping": {
    "approvalLevel": {
      "fieldRef": "/steps/level/level",
      "required": true
    },
    "branchReviewer": {
      "fieldRef": "/steps/branchReview/decidedBy",
      "required": false
    }
  },
