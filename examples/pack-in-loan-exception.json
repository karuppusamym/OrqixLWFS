      "from": "branchReview",
      "to": "notifyRejected",
      "on": "rejected"
    },
    {
      "id": "t5",
      "from": "relatedRoute",
      "to": "compliance",
      "on": "condition",
      "label": "Director, staff or related party",
      "condition": {
        "fieldRef": "/input/relatedParty",
        "operator": "eq",
        "value": true
      }
    },
    {
      "id": "t6",
      "from": "relatedRoute",
      "to": "levelRoute",
      "on": "default",
      "label": "Not related"
    },
