  "decisions": [
    {
      "key": "review-scope",
      "version": 1,
      "hitPolicy": "FIRST",
      "rows": [
        {
          "when": {
            "all": [
              {
                "fieldRef": "/input/height",
                "operator": "gte",
                "value": 15
              },
              {
                "fieldRef": "/input/heritageArea",
                "operator": "eq",
                "value": true
              }
            ]
          },
          "then": {
            "fire": true,
            "heritage": true
          }
        },
        {
          "when": {
            "all": [
              {
                "fieldRef": "/input/buildingUse",
                "operator": "eq",
                "value": "Assembly"
              },
              {
                "fieldRef": "/input/heritageArea",
                "operator": "eq",
                "value": true
              }
            ]
          },
          "then": {
            "fire": true,
            "heritage": true
          }
        },
        {
          "when": {
            "fieldRef": "/input/height",
            "operator": "gte",
            "value": 15
          },
          "then": {
            "fire": true,
            "heritage": false
          }
        },
        {
          "when": {
            "fieldRef": "/input/buildingUse",
            "operator": "eq",
            "value": "Assembly"
          },
          "then": {
            "fire": true,
            "heritage": false
          }
        },
        {
          "when": {
            "fieldRef": "/input/heritageArea",
            "operator": "eq",
            "value": true
          },
          "then": {
            "fire": false,
            "heritage": true
          }
        }
      ],
      "default": {
        "fire": false,
        "heritage": false
      }
    }
  ],
  "execution": {
    "maxConcurrentRuns": 200,
    "maxAttempts": 3,
    "retryDelaySeconds": 30
  },
  "security": {
    "selfApproval": "deny"
  },
  "dependencies": {
    "connections": []
