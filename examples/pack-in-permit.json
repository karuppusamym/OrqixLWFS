{
  "schemaVersion": "0.1",
  "workflowKey": "permit-in",
  "name": "Building plan approval (India)",
  "metadata": {
    "description": "India building plan approval for a municipal office. A clerk checks completeness, planning scrutinises the plans, then fire and heritage reviews run only when the rules ask for them (inclusive split), and the permit authority decides within 30 days or the case escalates. Due dates count office hours and public holidays. Fire NOC from 15 m (National Building Code high-rise threshold) or for assembly use; heritage review inside a notified heritage zone; escalation to the commissioner after 30 days, where many state rules allow deemed sanction. Illustrative regional template, not a regulatory-compliant product: thresholds, holiday lists and document names are placeholders for your compliance function to confirm.",
    "tags": [
      "pack:public-sector",
      "region:india",
      "template:permit",
      "owner:Municipal permit office",
      "illustrative",
      "lang:hi"
    ]
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "applicantName",
      "buildingUse",
      "floors",
      "height",
      "propertyId",
      "plotArea",
      "architect",
      "heritageArea"
    ],
    "properties": {
      "applicantName": {
        "type": "string",
        "title": "Applicant name / आवेदक का नाम",
        "minLength": 1,
        "maxLength": 200
      },
      "propertyId": {
        "type": "string",
        "title": "Property ID or survey number / संपत्ति आईडी या सर्वे संख्या",
        "minLength": 1,
        "maxLength": 60
      },
      "ward": {
        "type": "string",
        "title": "Ward or zone / वार्ड या ज़ोन",
        "minLength": 1,
        "maxLength": 60
      },
      "buildingUse": {
        "type": "string",
        "title": "Building use / भवन उपयोग",
        "enum": [
          "Residential",
          "Commercial",
          "Mixed use",
          "Institutional",
          "Assembly"
        ]
      },
      "plotArea": {
        "type": "number",
        "title": "Plot area (m²) / भूखंड क्षेत्र (वर्ग मीटर)",
        "minimum": 1,
        "maximum": 1000000,
        "multipleOf": 0.01
      },
      "floors": {
        "type": "integer",
        "title": "Floors / मंज़िलें",
        "minimum": 1,
        "maximum": 60
      },
      "height": {
        "type": "number",
        "title": "Building height (m) / भवन की ऊंचाई (मीटर)",
        "minimum": 1,
        "maximum": 300,
        "multipleOf": 0.01
      },
      "heritageArea": {
        "type": "boolean",
        "title": "Inside a notified heritage zone / अधिसूचित विरासत क्षेत्र के भीतर"
      },
      "architect": {
        "type": "string",
        "title": "Architect registration (CoA) / वास्तुकार पंजीकरण (CoA)",
        "minLength": 6,
        "maxLength": 30,
        "pattern": "^CA/[0-9]{4}/[0-9]{3,6}$",
        "patternMessage": "Enter the Council of Architecture number, for example CA/2015/12345."
      }
    }
  },
  "inputUi": {
    "order": [
      "applicantName",
      "propertyId",
      "ward",
      "buildingUse",
      "plotArea",
      "floors",
      "height",
      "heritageArea",
      "architect"
    ],
    "widgets": {
      "buildingUse": "select",
      "plotArea": "number",
      "height": "number",
      "heritageArea": "checkbox"
    },
    "submitLabel": "Submit application / आवेदन जमा करें",
    "layout": {
      "sections": [
        {
          "id": "applicant",
          "title": "Applicant / आवेदक",
          "columns": 2,
          "fields": [
            "applicantName",
            "architect",
            "propertyId",
            "ward"
