{
  "schemaVersion": "0.1",
  "workflowKey": "vendor-onboarding-in",
  "name": "Vendor onboarding (India)",
  "metadata": {
    "description": "India vendor onboarding in INR without any connection. Procurement due diligence and bank-detail verification run in parallel; vendors that process personal data get a privacy review (Digital Personal Data Protection Act 2023); a declared conflict of interest or spend of INR 50 lakh or more needs compliance approval. The GSTIN is format-checked on the form. Due dates count India office hours and public holidays. MSME vendors are flagged so payment within 45 days (MSMED Act section 43B(h)) can be tracked. Illustrative regional template, not a regulatory-compliant product: thresholds, holiday lists and document names are placeholders for your compliance function to confirm.",
    "tags": [
      "pack:shared-services",
      "region:india",
      "template:vendor-onboarding",
      "owner:Procurement operations",
      "illustrative",
      "lang:hi"
    ]
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "vendorName",
      "taxId",
      "category",
      "annualSpend",
      "personalData",
      "conflictOfInterest"
    ],
    "properties": {
      "vendorName": {
        "type": "string",
        "title": "Vendor legal name / विक्रेता का कानूनी नाम",
        "minLength": 1,
        "maxLength": 200
      },
      "taxId": {
        "type": "string",
        "title": "GSTIN / जीएसटीआईएन",
        "minLength": 4,
        "maxLength": 20,
        "pattern": "^[0-9]{2}[A-Z]{5}[0-9]{4}[A-Z][1-9A-Z]Z[0-9A-Z]$",
        "patternMessage": "Enter a 15-character GSTIN, for example 27AAPFU0939F1ZV."
      },
      "category": {
        "type": "string",
        "title": "Category / श्रेणी",
        "enum": [
          "Goods",
          "Services",
          "IT and software",
          "Works and construction",
          "Professional services"
        ]
      },
      "annualSpend": {
        "type": "number",
        "title": "Expected annual spend (INR) / अनुमानित वार्षिक व्यय (₹)",
        "minimum": 1,
        "maximum": 10000000000,
        "multipleOf": 0.01
      },
      "msme": {
        "type": "boolean",
        "title": "MSME (Udyam) registered / एमएसएमई (उद्यम) पंजीकृत"
      },
      "personalData": {
        "type": "boolean",
        "title": "Vendor will process personal data / विक्रेता व्यक्तिगत डेटा संसाधित करेगा"
      },
      "conflictOfInterest": {
        "type": "boolean",
        "title": "Possible conflict of interest declared / संभावित हितों का टकराव घोषित"
      }
    }
  },
  "inputUi": {
    "order": [
      "vendorName",
      "taxId",
      "category",
      "annualSpend",
      "msme",
      "personalData",
      "conflictOfInterest"
    ],
    "widgets": {
      "category": "select",
      "annualSpend": "number",
      "msme": "checkbox",
      "personalData": "checkbox",
      "conflictOfInterest": "checkbox"
    },
    "submitLabel": "Submit vendor / विक्रेता जमा करें",
    "layout": {
      "sections": [
        {
          "id": "vendor",
          "title": "Vendor / विक्रेता",
          "columns": 2,
          "fields": [
            "vendorName",
            "taxId",
            "category",
            "annualSpend",
            "msme"
          ]
        },
        {
          "id": "risk",
          "title": "Risk / जोखिम",
          "columns": 1,
          "fields": [
            "personalData",
            "conflictOfInterest"
          ]
        }
      ]
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "riskBand": {
        "type": "string",
        "title": "Risk band"
      },
      "diligenceBy": {
        "type": "string",
        "title": "Due diligence by"
      }
    }
  },
