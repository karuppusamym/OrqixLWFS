      "to": "compliance",
      "on": "condition",
      "label": "Conflict declared or INR 50 lakh or more",
      "condition": {
        "fieldRef": "/steps/risk/band",
        "operator": "eq",
        "value": "high"
      }
    },
    {
      "id": "t15",
      "from": "riskRoute",
      "to": "notifyApproved",
      "on": "default",
      "label": "Standard risk"
    },
    {
      "id": "t16",
      "from": "compliance",
      "to": "notifyApproved",
      "on": "approved"
