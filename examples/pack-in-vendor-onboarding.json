      "on": "next"
    },
    {
      "id": "t19",
      "from": "notifyRejected",
      "to": "rejected",
      "on": "next"
    }
  ],
  "decisions": [
    {
      "key": "vendor-risk",
      "version": 1,
      "hitPolicy": "FIRST",
      "rows": [
        {
          "when": {
            "any": [
              {
                "fieldRef": "/input/conflictOfInterest",
                "operator": "eq",
                "value": true
              },
              {
                "fieldRef": "/input/annualSpend",
                "operator": "gte",
                "value": 5000000
              }
            ]
          },
          "then": {
            "band": "high"
          }
        }
      ],
      "default": {
        "band": "standard"
      }
    }
  ],
  "execution": {
    "maxConcurrentRuns": 200,
    "maxAttempts": 3,
    "retryDelaySeconds": 30
  },
  "security": {
    "selfApproval": "deny"
  },
  "dependencies": {
    "connections": []
  },
  "outputMapping": {
