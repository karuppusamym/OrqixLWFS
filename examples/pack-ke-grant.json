{
  "schemaVersion": "0.1",
  "workflowKey": "grant-application-ke",
  "name": "Grant application (Kenya)",
  "metadata": {
    "description": "Kenya grant application in KES. Rules reject requests above KES 2,000,000 or with own contribution under 10 percent; two reviewers on the technical panel must both approve, finance checks the budget, and the grants committee decides from KES 500,000. Due dates count office hours and public holidays. Built for a county or ward development fund; groups give their registration number from the Social Development office. Illustrative regional template, not a regulatory-compliant product: thresholds, holiday lists and document names are placeholders for your compliance function to confirm.",
    "tags": [
      "pack:public-sector",
      "region:kenya",
      "template:grant",
      "owner:Grants office",
      "illustrative",
      "lang:sw"
    ]
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "organisationName",
      "organisationType",
      "registrationId",
      "programme",
      "requestedAmount",
      "ownContribution",
      "projectSummary",
      "budget"
    ],
    "properties": {
      "organisationName": {
        "type": "string",
        "title": "Organisation name / Jina la shirika",
        "minLength": 1,
        "maxLength": 200
      },
      "organisationType": {
        "type": "string",
        "title": "Organisation type / Aina ya shirika",
        "enum": [
          "Community-based organisation",
          "Youth group",
          "Women group",
          "Persons with disability group",
          "Cooperative society"
        ]
      },
      "registrationId": {
        "type": "string",
        "title": "Registration number / Nambari ya usajili",
        "minLength": 3,
        "maxLength": 40,
        "pattern": "^[A-Za-z0-9 /.-]{3,40}$",
        "patternMessage": "Enter the registration number from the certificate."
      },
      "programme": {
        "type": "string",
        "title": "Programme / Mpango",
        "enum": [
          "Youth enterprise",
          "Women enterprise",
          "Agriculture value chains",
          "Water projects",
          "Ward development"
        ]
      },
      "requestedAmount": {
        "type": "number",
        "title": "Requested amount (KES) / Kiasi kinachoombwa (KES)",
        "minimum": 1,
        "maximum": 10000000000,
        "multipleOf": 0.01
      },
      "ownContribution": {
        "type": "integer",
        "title": "Own contribution (%) / Mchango binafsi (%)",
        "minimum": 0,
        "maximum": 100
      },
      "projectSummary": {
        "type": "string",
        "title": "Project summary / Muhtasari wa mradi",
        "minLength": 20,
        "maxLength": 4000
      },
      "budget": {
        "type": "array",
        "title": "Budget lines / Vipengele vya bajeti",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "item",
            "amount"
          ],
          "properties": {
            "item": {
              "type": "string",
              "title": "Budget item / Kipengele cha bajeti",
              "minLength": 1,
              "maxLength": 100
            },
            "amount": {
              "type": "number",
              "title": "Requested amount (KES) / Kiasi kinachoombwa (KES)",
              "minimum": 1,
              "maximum": 100000000,
              "multipleOf": 0.01
            }
          }
        }
      }
    }
  },
  "inputUi": {
    "order": [
      "organisationName",
      "organisationType",
      "registrationId",
      "programme",
      "requestedAmount",
      "ownContribution",
      "projectSummary",
      "budget"
    ],
    "widgets": {
      "organisationType": "select",
      "programme": "select",
      "requestedAmount": "number",
      "projectSummary": "textarea"
    },
    "submitLabel": "Submit application / Wasilisha ombi",
    "layout": {
      "sections": [
        {
          "id": "organisation",
          "title": "Organisation / Shirika",
          "columns": 2,
          "fields": [
            "organisationName",
            "organisationType",
            "registrationId"
          ]
        },
        {
          "id": "project",
          "title": "Project / Mradi",
          "columns": 1,
          "fields": [
            "programme",
            "requestedAmount",
            "ownContribution",
            "projectSummary",
            "budget"
          ]
        }
      ]
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "budgetTotal": {
        "type": "number",
        "title": "Budget total (KES)"
      },
      "financeCheckedBy": {
        "type": "string",
        "title": "Finance checked by"
      }
    }
  },
  "triggers": [
    "manual",
    "api"
  ],
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "label": "Application received",
      "config": {}
    },
    {
      "id": "eligibility",
      "type": "decision",
      "label": "Check eligibility",
      "config": {
        "decisionRef": "grant-eligibility"
      }
    },
    {
      "id": "eligibleRoute",
      "type": "branch",
      "label": "Eligible?",
      "config": {}
    },
    {
      "id": "notifyIneligible",
      "type": "notification",
      "label": "Tell applicant it is not eligible",
      "config": {
        "channel": "inApp",
        "recipient": "initiator",
        "message": "The application does not meet the programme's eligibility rules. / Ombi halitimizi masharti ya ustahiki ya mpango."
      }
    },
    {
      "id": "panel",
      "type": "approval",
      "label": "Technical review panel / Jopo la ukaguzi wa kiufundi",
      "config": {
        "candidateGroupRef": "grant-reviewers",
        "rejectReasonRequired": true,
        "multiInstance": {
          "approvers": 2
        }
      }
    },
    {
      "id": "finance",
      "type": "approval",
      "label": "Finance check / Ukaguzi wa fedha",
      "config": {
        "candidateGroupRef": "grants-finance",
        "rejectReasonRequired": true,
        "dueAfterHours": 24,
        "calendar": {
          "zone": "Africa/Nairobi",
          "weekdays": [
            1,
            2,
            3,
            4,
            5
          ],
          "holidays": [
            "2026-01-01",
            "2026-03-20",
            "2026-04-03",
            "2026-04-06",
            "2026-05-01",
            "2026-05-27",
            "2026-06-01",
            "2026-10-10",
            "2026-10-20",
            "2026-12-12",
            "2026-12-25",
            "2026-12-26",
            "2027-01-01",
            "2027-03-26",
            "2027-03-29",
            "2027-05-01",
            "2027-06-01",
            "2027-10-10",
            "2027-10-11",
            "2027-10-20",
            "2027-12-12",
            "2027-12-13",
            "2027-12-25",
            "2027-12-26",
            "2027-12-27"
          ],
          "start": "08:00",
          "end": "17:00",
          "revision": "KE-office-2026-illustrative",
          "validFrom": "2026-01-01",
          "intervals": [
            {
              "start": "08:00",
              "end": "13:00"
            },
            {
              "start": "14:00",
              "end": "17:00"
            }
          ]
        }
      }
    },
    {
      "id": "levelRoute",
      "type": "branch",
      "label": "Committee needed?",
      "config": {}
    },
    {
      "id": "committee",
      "type": "approval",
      "label": "Grants committee approval / Idhini ya kamati ya ruzuku",
      "config": {
        "candidateGroupRef": "grants-committee",
        "rejectReasonRequired": true,
        "dueAfterHours": 80,
        "calendar": {
          "zone": "Africa/Nairobi",
          "weekdays": [
            1,
            2,
            3,
            4,
            5
          ],
          "holidays": [
            "2026-01-01",
            "2026-03-20",
            "2026-04-03",
            "2026-04-06",
            "2026-05-01",
            "2026-05-27",
            "2026-06-01",
            "2026-10-10",
            "2026-10-20",
            "2026-12-12",
            "2026-12-25",
            "2026-12-26",
            "2027-01-01",
            "2027-03-26",
            "2027-03-29",
            "2027-05-01",
            "2027-06-01",
            "2027-10-10",
            "2027-10-11",
            "2027-10-20",
            "2027-12-12",
            "2027-12-13",
            "2027-12-25",
            "2027-12-26",
            "2027-12-27"
          ],
          "start": "08:00",
          "end": "17:00",
          "revision": "KE-office-2026-illustrative",
          "validFrom": "2026-01-01",
          "intervals": [
            {
              "start": "08:00",
              "end": "13:00"
            },
            {
              "start": "14:00",
              "end": "17:00"
            }
          ]
        }
      }
    },
    {
      "id": "notifyAwarded",
      "type": "notification",
      "label": "Tell applicant the grant was awarded",
      "config": {
        "channel": "inApp",
        "recipient": "initiator",
        "message": "The grant was awarded. / Ruzuku imetolewa."
      }
    },
    {
      "id": "notifyRejected",
      "type": "notification",
      "label": "Tell applicant it was rejected",
      "config": {
        "channel": "inApp",
        "recipient": "initiator",
        "message": "The grant application was rejected. Open the request to see the reason. / Ombi la ruzuku limekataliwa. Fungua ombi kuona sababu."
      }
    },
    {
      "id": "awarded",
      "type": "end",
      "label": "Awarded",
      "config": {
        "businessOutcome": "Awarded",
        "outcomeKind": "success"
      }
    },
    {
      "id": "rejected",
      "type": "end",
      "label": "Rejected",
      "config": {
        "businessOutcome": "Rejected",
        "outcomeKind": "rejected"
      }
    },
    {
      "id": "ineligible",
      "type": "end",
      "label": "Ineligible",
      "config": {
        "businessOutcome": "Ineligible",
        "outcomeKind": "rejected"
      }
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "start",
      "to": "eligibility",
      "on": "next"
    },
    {
      "id": "t2",
      "from": "eligibility",
      "to": "eligibleRoute",
      "on": "next"
    },
    {
      "id": "t3",
      "from": "eligibleRoute",
      "to": "notifyIneligible",
      "on": "condition",
      "label": "Eligibility rule not met",
      "condition": {
        "fieldRef": "/steps/eligibility/eligible",
        "operator": "eq",
        "value": false
      }
    },
    {
      "id": "t4",
      "from": "eligibleRoute",
      "to": "panel",
      "on": "default",
      "label": "Eligible"
    },
    {
      "id": "t5",
      "from": "notifyIneligible",
      "to": "ineligible",
      "on": "next"
    },
    {
      "id": "t6",
      "from": "panel",
      "to": "finance",
      "on": "approved"
    },
    {
      "id": "t7",
      "from": "panel",
      "to": "notifyRejected",
      "on": "rejected"
    },
    {
      "id": "t8",
      "from": "finance",
      "to": "levelRoute",
      "on": "approved"
    },
    {
      "id": "t9",
      "from": "finance",
      "to": "notifyRejected",
      "on": "rejected"
    },
    {
      "id": "t10",
      "from": "levelRoute",
      "to": "committee",
      "on": "condition",
      "label": "KES 500,000 or more",
      "condition": {
        "fieldRef": "/input/requestedAmount",
        "operator": "gte",
        "value": 500000
      }
    },
    {
      "id": "t11",
      "from": "levelRoute",
      "to": "notifyAwarded",
      "on": "default",
      "label": "Below committee threshold"
    },
    {
      "id": "t12",
      "from": "committee",
      "to": "notifyAwarded",
      "on": "approved"
    },
    {
      "id": "t13",
      "from": "committee",
      "to": "notifyRejected",
      "on": "rejected"
    },
    {
      "id": "t14",
      "from": "notifyAwarded",
      "to": "awarded",
      "on": "next"
    },
    {
      "id": "t15",
      "from": "notifyRejected",
      "to": "rejected",
      "on": "next"
    }
  ],
  "decisions": [
    {
      "key": "grant-eligibility",
      "version": 1,
      "hitPolicy": "FIRST",
      "rows": [
        {
          "when": {
            "any": [
              {
                "fieldRef": "/input/requestedAmount",
                "operator": "gt",
                "value": 2000000
              },
              {
                "fieldRef": "/input/ownContribution",
                "operator": "lt",
                "value": 10
              }
            ]
          },
          "then": {
            "eligible": false
          }
        }
      ],
      "default": {
        "eligible": true
      }
    }
  ],
  "execution": {
    "maxConcurrentRuns": 200,
    "maxAttempts": 3,
    "retryDelaySeconds": 30
  },
  "security": {
    "selfApproval": "deny"
  },
  "dependencies": {
    "connections": []
  },
  "outputMapping": {
    "budgetTotal": {
      "fieldRef": "/input/budget/sum/amount",
      "required": true
    },
    "financeCheckedBy": {
      "fieldRef": "/steps/finance/decidedBy",
      "required": false
    }
  },
  "uiLayout": {
    "positions": {
      "start": {
        "x": 80,
        "y": 80
      },
