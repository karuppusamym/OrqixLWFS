{
  "schemaVersion": "0.1",
  "workflowKey": "loan-exception-ke",
  "name": "Loan exception approval (Kenya)",
  "metadata": {
    "description": "Kenya loan exception approval in KES. A loan that breaks credit policy goes to the branch manager, then by amount to the credit head (from KES 1,000,000) or a two-member credit committee (from KES 5,000,000). Related-party loans also need compliance. Due dates count Kenya banking hours and public holidays. Built for a SACCO or microfinance bank; the credit committee approves insider loans as SASRA rules expect. Illustrative regional template, not a regulatory-compliant product: thresholds, holiday lists and document names are placeholders for your compliance function to confirm.",
    "tags": [
      "pack:banking-mfi",
      "region:kenya",
      "template:loan-exception",
      "owner:Credit operations",
      "illustrative",
      "lang:sw"
    ]
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "loanReference",
      "borrowerSegment",
      "amount",
      "exceptionType",
      "exceptionDetail",
      "relatedParty"
    ],
    "properties": {
      "loanReference": {
        "type": "string",
        "title": "Loan reference / Kumbukumbu ya mkopo",
        "minLength": 3,
        "maxLength": 30,
        "pattern": "^[A-Za-z0-9-]{3,30}$",
        "patternMessage": "Use 3 to 30 letters, digits and dashes, for example LN-2026-0042."
      },
      "borrowerSegment": {
        "type": "string",
        "title": "Borrower segment / Aina ya mkopaji",
        "enum": [
          "Individual member",
          "Business member",
          "Chama or group member"
        ]
      },
      "amount": {
        "type": "number",
        "title": "Loan amount (KES) / Kiasi cha mkopo (KES)",
        "minimum": 1,
        "maximum": 10000000000,
        "multipleOf": 0.01
      },
      "exceptionType": {
        "type": "string",
        "title": "Policy exception / Upekee wa sera",
        "enum": [
          "Rate concession",
          "Tenor beyond policy",
          "Deposit multiple exceeded",
          "Guarantor shortfall",
          "Negative CRB listing",
          "Collateral shortfall"
        ]
      },
      "exceptionDetail": {
        "type": "string",
        "title": "What breaks policy, and why accept it / Sera ipi inavunjwa, na kwa nini ikubaliwe",
        "minLength": 10,
        "maxLength": 2000
      },
      "mitigants": {
        "type": "string",
        "title": "Mitigants / Hatua za kupunguza hatari",
        "minLength": 0,
        "maxLength": 2000
      },
      "relatedParty": {
        "type": "boolean",
        "title": "Borrower is an insider or related party / Mkopaji ni mhusika wa ndani au wa karibu"
      }
    }
  },
  "inputUi": {
    "order": [
      "loanReference",
      "borrowerSegment",
      "amount",
      "exceptionType",
      "exceptionDetail",
      "mitigants",
      "relatedParty"
    ],
    "widgets": {
      "borrowerSegment": "select",
      "amount": "number",
      "exceptionType": "select",
      "exceptionDetail": "textarea",
      "mitigants": "textarea",
      "relatedParty": "checkbox"
    },
    "submitLabel": "Submit exception / Wasilisha upekee",
    "layout": {
      "sections": [
        {
          "id": "loan",
          "title": "Loan / Mkopo",
          "columns": 2,
          "fields": [
            "loanReference",
            "borrowerSegment",
            "amount",
            "relatedParty"
          ]
        },
        {
          "id": "exception",
          "title": "Exception / Upekee",
          "columns": 1,
          "fields": [
            "exceptionType",
            "exceptionDetail",
            "mitigants"
          ]
        }
      ]
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "approvalLevel": {
        "type": "string",
        "title": "Approval level"
      },
      "branchReviewer": {
        "type": "string",
        "title": "Branch reviewer"
      }
    }
  },
  "triggers": [
    "manual",
    "api"
  ],
