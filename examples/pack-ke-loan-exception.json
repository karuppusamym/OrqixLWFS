    },
    {
      "id": "levelRoute",
      "type": "branch",
      "label": "Which approval level?",
      "config": {}
    },
    {
      "id": "creditHead",
      "type": "approval",
      "label": "Credit head approval / Idhini ya mkuu wa mikopo",
      "config": {
        "candidateGroupRef": "credit-heads",
        "rejectReasonRequired": true,
        "dueAfterHours": 16,
        "calendar": {
          "zone": "Africa/Nairobi",
          "weekdays": [
            1,
