        }
      }
    },
    {
      "id": "committee",
      "type": "approval",
      "label": "Credit committee approval / Idhini ya kamati ya mikopo",
      "config": {
        "candidateGroupRef": "credit-committee",
        "rejectReasonRequired": true,
        "multiInstance": {
          "approvers": 2
        }
      }
    },
    {
      "id": "notifyApproved",
      "type": "notification",
      "label": "Tell requester it was approved",
      "config": {
        "channel": "inApp",
        "recipient": "initiator",
        "message": "The loan exception was approved. / Upekee wa mkopo umeidhinishwa."
      }
    },
    {
      "id": "notifyRejected",
      "type": "notification",
      "label": "Tell requester it was rejected",
      "config": {
        "channel": "inApp",
        "recipient": "initiator",
        "message": "The loan exception was rejected. Open the request to see the reason. / Upekee wa mkopo umekataliwa. Fungua ombi kuona sababu."
      }
    },
    {
      "id": "approved",
      "type": "end",
      "label": "Approved",
      "config": {
        "businessOutcome": "Approved",
        "outcomeKind": "success"
      }
    },
    {
      "id": "rejected",
      "type": "end",
      "label": "Rejected",
      "config": {
        "businessOutcome": "Rejected",
        "outcomeKind": "rejected"
      }
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "start",
      "to": "level",
      "on": "next"
    },
    {
      "id": "t2",
      "from": "level",
      "to": "branchReview",
      "on": "next"
    },
    {
      "id": "t3",
      "from": "branchReview",
      "to": "relatedRoute",
      "on": "approved"
    },
    {
      "id": "t4",
      "from": "branchReview",
      "to": "notifyRejected",
      "on": "rejected"
    },
    {
      "id": "t5",
      "from": "relatedRoute",
      "to": "compliance",
      "on": "condition",
      "label": "Director, staff or related party",
      "condition": {
        "fieldRef": "/input/relatedParty",
        "operator": "eq",
        "value": true
      }
    },
    {
      "id": "t6",
      "from": "relatedRoute",
      "to": "levelRoute",
      "on": "default",
      "label": "Not related"
    },
    {
      "id": "t7",
      "from": "compliance",
      "to": "levelRoute",
      "on": "approved"
    },
    {
      "id": "t8",
      "from": "compliance",
      "to": "notifyRejected",
      "on": "rejected"
    },
    {
      "id": "t9",
      "from": "levelRoute",
      "to": "committee",
      "on": "condition",
      "label": "KES 5,000,000 or more",
      "condition": {
        "fieldRef": "/steps/level/level",
        "operator": "eq",
        "value": "committee"
      }
    },
    {
      "id": "t10",
      "from": "levelRoute",
      "to": "creditHead",
      "on": "condition",
      "label": "KES 1,000,000 or more",
      "condition": {
        "fieldRef": "/steps/level/level",
        "operator": "eq",
        "value": "creditHead"
      }
    },
    {
      "id": "t11",
      "from": "levelRoute",
      "to": "notifyApproved",
      "on": "default",
      "label": "Within branch powers"
    },
    {
      "id": "t12",
      "from": "creditHead",
      "to": "notifyApproved",
      "on": "approved"
    },
    {
      "id": "t13",
      "from": "creditHead",
      "to": "notifyRejected",
      "on": "rejected"
    },
    {
      "id": "t14",
      "from": "committee",
      "to": "notifyApproved",
      "on": "approved"
    },
    {
      "id": "t15",
      "from": "committee",
      "to": "notifyRejected",
      "on": "rejected"
    },
    {
      "id": "t16",
      "from": "notifyApproved",
      "to": "approved",
      "on": "next"
    },
    {
      "id": "t17",
      "from": "notifyRejected",
      "to": "rejected",
      "on": "next"
    }
  ],
  "decisions": [
    {
      "key": "exception-level",
      "version": 1,
      "hitPolicy": "FIRST",
      "rows": [
        {
          "when": {
            "fieldRef": "/input/amount",
            "operator": "gte",
            "value": 5000000
          },
          "then": {
            "level": "committee"
          }
        },
        {
          "when": {
            "fieldRef": "/input/amount",
            "operator": "gte",
            "value": 1000000
          },
          "then": {
            "level": "creditHead"
          }
        }
      ],
      "default": {
        "level": "branch"
      }
    }
  ],
  "execution": {
    "maxConcurrentRuns": 200,
    "maxAttempts": 3,
    "retryDelaySeconds": 30
  },
  "security": {
    "selfApproval": "deny"
  },
  "dependencies": {
    "connections": []
  },
  "outputMapping": {
    "approvalLevel": {
      "fieldRef": "/steps/level/level",
      "required": true
    },
    "branchReviewer": {
      "fieldRef": "/steps/branchReview/decidedBy",
      "required": false
    }
  },
