      "on": "next"
    },
    {
      "id": "t4",
      "from": "intake",
      "to": "inspections",
      "on": "approved"
    },
    {
      "id": "t5",
      "from": "intake",
      "to": "notifyRefused",
      "on": "rejected"
    },
    {
      "id": "t6",
      "from": "inspections",
      "to": "health",
      "on": "condition",
      "label": "Food, drink or lodging",
      "condition": {
        "fieldRef": "/steps/scope/health",
        "operator": "eq",
        "value": true
      }
    },
    {
      "id": "t7",
      "from": "inspections",
      "to": "fire",
      "on": "condition",
      "label": "Large premises or hazardous goods",
      "condition": {
        "fieldRef": "/steps/scope/fire",
        "operator": "eq",
        "value": true
      }
    },
    {
      "id": "t8",
      "from": "inspections",
      "to": "noInspection",
      "on": "default",
      "label": "No inspection"
    },
    {
      "id": "t9",
      "from": "health",
      "to": "inspectionsDone",
      "on": "approved"
    },
    {
      "id": "t10",
      "from": "health",
      "to": "notifyRefused",
      "on": "rejected"
    },
    {
      "id": "t11",
      "from": "fire",
      "to": "inspectionsDone",
      "on": "approved"
    },
    {
      "id": "t12",
      "from": "fire",
      "to": "notifyRefused",
      "on": "rejected"
    },
    {
      "id": "t13",
      "from": "noInspection",
      "to": "inspectionsDone",
      "on": "next"
    },
    {
      "id": "t14",
      "from": "inspectionsDone",
      "to": "decision",
      "on": "next"
    },
    {
      "id": "t15",
      "from": "decision",
      "to": "notifyGranted",
      "on": "approved"
    },
    {
      "id": "t16",
      "from": "decision",
      "to": "notifyRefused",
      "on": "rejected"
    },
    {
      "id": "t17",
      "from": "decision",
      "to": "escalation",
      "on": "timedOut",
      "label": "Not decided in 14 days"
    },
    {
      "id": "t18",
      "from": "escalation",
      "to": "notifyGranted",
      "on": "approved"
    },
    {
      "id": "t19",
      "from": "escalation",
      "to": "notifyRefused",
      "on": "rejected"
    },
    {
      "id": "t20",
      "from": "notifyGranted",
      "to": "granted",
      "on": "next"
    },
    {
      "id": "t21",
      "from": "notifyRefused",
      "to": "refused",
      "on": "next"
    }
  ],
  "decisions": [
    {
      "key": "review-scope",
      "version": 1,
      "hitPolicy": "FIRST",
      "rows": [
        {
          "when": {
            "all": [
              {
                "fieldRef": "/input/activity",
                "operator": "eq",
                "value": "Hotel, restaurant or bar"
              },
              {
                "fieldRef": "/input/premisesArea",
                "operator": "gte",
                "value": 500
              }
            ]
          },
          "then": {
            "health": true,
            "fire": true
          }
        },
        {
          "when": {
            "fieldRef": "/input/activity",
            "operator": "eq",
            "value": "Hotel, restaurant or bar"
          },
          "then": {
            "health": true,
            "fire": false
          }
        },
        {
          "when": {
            "fieldRef": "/input/activity",
            "operator": "eq",
            "value": "Hazardous goods: fuel, gas, chemicals"
          },
          "then": {
            "health": false,
            "fire": true
          }
        },
        {
          "when": {
            "fieldRef": "/input/premisesArea",
            "operator": "gte",
            "value": 500
          },
          "then": {
            "health": false,
            "fire": true
          }
        }
      ],
      "default": {
        "health": false,
        "fire": false
      }
    },
    {
      "key": "permit-fee",
      "version": 1,
      "hitPolicy": "FIRST",
      "rows": [
        {
          "when": {
            "fieldRef": "/input/employees",
            "operator": "gt",
            "value": 50
          },
          "then": {
            "feeBand": "Large",
            "feeKes": 30000
          }
        },
        {
          "when": {
            "fieldRef": "/input/employees",
            "operator": "gt",
            "value": 5
          },
          "then": {
            "feeBand": "Medium",
            "feeKes": 15000
          }
        }
      ],
      "default": {
        "feeBand": "Small",
        "feeKes": 5000
      }
    }
  ],
  "execution": {
    "maxConcurrentRuns": 200,
    "maxAttempts": 3,
    "retryDelaySeconds": 30
  },
  "security": {
    "selfApproval": "deny"
  },
  "dependencies": {
    "connections": []
  },
  "outputMapping": {
    "feeBand": {
