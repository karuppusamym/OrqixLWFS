{
  "schemaVersion": "0.1",
  "workflowKey": "permit-ke",
  "name": "Single business permit (Kenya)",
  "metadata": {
    "description": "Kenya county single business permit. A clerk checks completeness, a rule table sets the fee band from the number of employees (KES 5,000, 15,000 or 30,000 as placeholders for the county Finance Act), public health and fire inspections run only when the activity or premises need them, and the permit authority decides within 14 days or the case goes to the chief officer. Due dates count county office hours and Kenyan public holidays. Illustrative regional template, not a regulatory-compliant product: thresholds, holiday lists and document names are placeholders for your compliance function to confirm.",
    "tags": [
      "pack:public-sector",
      "region:kenya",
      "template:permit",
      "owner:County licensing office",
      "illustrative",
      "lang:sw"
    ]
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "businessName",
      "kraPin",
      "activity",
      "ward",
      "premisesArea",
      "employees"
    ],
    "properties": {
      "businessName": {
        "type": "string",
        "title": "Business name / Jina la biashara",
        "minLength": 1,
        "maxLength": 200
      },
      "kraPin": {
        "type": "string",
        "title": "KRA PIN / PIN ya KRA",
        "minLength": 11,
        "maxLength": 11,
        "pattern": "^[AP][0-9]{9}[A-Z]$",
        "patternMessage": "Enter an 11-character KRA PIN, for example P051234567X."
      },
      "activity": {
        "type": "string",
        "title": "Business activity / Shughuli ya biashara",
        "enum": [
          "Small trader or shop",
          "Hotel, restaurant or bar",
          "Professional services",
          "Manufacturing",
          "Hazardous goods: fuel, gas, chemicals",
          "Transport and storage"
        ]
      },
      "ward": {
        "type": "string",
        "title": "Ward / Wadi",
        "minLength": 1,
        "maxLength": 60
      },
      "premisesArea": {
        "type": "number",
        "title": "Premises area (m²) / Ukubwa wa eneo la biashara (m²)",
        "minimum": 1,
        "maximum": 100000,
        "multipleOf": 0.01
      },
      "employees": {
        "type": "integer",
        "title": "Employees / Wafanyakazi",
        "minimum": 0,
        "maximum": 10000
      }
    }
  },
  "inputUi": {
    "order": [
      "businessName",
      "kraPin",
      "activity",
      "ward",
      "premisesArea",
      "employees"
    ],
    "widgets": {
      "activity": "select",
      "premisesArea": "number"
    },
    "submitLabel": "Submit application / Wasilisha ombi",
    "layout": {
      "sections": [
        {
          "id": "business",
          "title": "Business / Biashara",
          "columns": 2,
          "fields": [
            "businessName",
            "kraPin",
            "activity"
          ]
        },
        {
          "id": "premises",
          "title": "Premises / Eneo la biashara",
          "columns": 2,
          "fields": [
            "ward",
            "premisesArea",
            "employees"
          ]
        }
      ]
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "feeBand": {
        "type": "string",
        "title": "Fee band"
      },
      "feeKes": {
        "type": "number",
        "title": "Permit fee (KES)"
      },
      "decidedBy": {
        "type": "string",
        "title": "Decided by"
      }
    }
  },
