{
  "schemaVersion": "0.1",
  "workflowKey": "vendor-onboarding-ke",
  "name": "Vendor onboarding (Kenya)",
  "metadata": {
    "description": "Kenya vendor onboarding in KES without any connection. Procurement due diligence and bank-detail verification run in parallel; vendors that process personal data get a privacy review (Data Protection Act 2019); a declared conflict of interest or spend of KES 10,000,000 or more needs compliance approval. The KRA PIN is format-checked on the form. Due dates count Kenya office hours and public holidays. AGPO vendors are flagged for the public procurement reservation; check the KRA tax compliance certificate. Illustrative regional template, not a regulatory-compliant product: thresholds, holiday lists and document names are placeholders for your compliance function to confirm.",
    "tags": [
      "pack:shared-services",
      "region:kenya",
      "template:vendor-onboarding",
      "owner:Procurement operations",
      "illustrative",
      "lang:sw"
    ]
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "vendorName",
      "taxId",
      "category",
      "annualSpend",
      "personalData",
      "conflictOfInterest"
    ],
    "properties": {
      "vendorName": {
        "type": "string",
        "title": "Vendor legal name / Jina rasmi la msambazaji",
        "minLength": 1,
        "maxLength": 200
      },
      "taxId": {
        "type": "string",
        "title": "KRA PIN / PIN ya KRA",
        "minLength": 4,
        "maxLength": 20,
        "pattern": "^[AP][0-9]{9}[A-Z]$",
        "patternMessage": "Enter an 11-character KRA PIN, for example P051234567X."
      },
      "category": {
        "type": "string",
        "title": "Category / Kundi",
        "enum": [
          "Goods",
          "Services",
          "IT and software",
          "Works and construction",
          "Professional services"
        ]
      },
      "annualSpend": {
        "type": "number",
        "title": "Expected annual spend (KES) / Matumizi yanayotarajiwa kwa mwaka (KES)",
        "minimum": 1,
        "maximum": 10000000000,
        "multipleOf": 0.01
      },
      "agpo": {
        "type": "boolean",
        "title": "AGPO certificate holder / Mwenye cheti cha AGPO"
      },
      "personalData": {
        "type": "boolean",
        "title": "Vendor will process personal data / Msambazaji atachakata data binafsi"
      },
      "conflictOfInterest": {
        "type": "boolean",
        "title": "Possible conflict of interest declared / Mgongano wa maslahi umetangazwa"
      }
    }
  },
  "inputUi": {
    "order": [
      "vendorName",
      "taxId",
      "category",
      "annualSpend",
      "agpo",
      "personalData",
      "conflictOfInterest"
    ],
    "widgets": {
      "category": "select",
      "annualSpend": "number",
      "agpo": "checkbox",
      "personalData": "checkbox",
      "conflictOfInterest": "checkbox"
    },
    "submitLabel": "Submit vendor / Wasilisha msambazaji",
    "layout": {
      "sections": [
        {
          "id": "vendor",
          "title": "Vendor / Msambazaji",
          "columns": 2,
          "fields": [
            "vendorName",
            "taxId",
            "category",
            "annualSpend",
            "agpo"
          ]
        },
        {
          "id": "risk",
          "title": "Risk / Hatari",
          "columns": 1,
          "fields": [
            "personalData",
            "conflictOfInterest"
          ]
        }
      ]
    }
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "riskBand": {
        "type": "string",
        "title": "Risk band"
      },
      "diligenceBy": {
        "type": "string",
        "title": "Due diligence by"
      }
    }
  },
  "triggers": [
    "manual",
    "api"
  ],
