{
  "schemaVersion": "0.1",
  "workflowKey": "purchase-approval",
  "name": "Purchase approval",
  "metadata": {
    "description": "Ask for approval to buy equipment or services. Your manager reviews every request, and purchases of USD 5,000 or more also need Finance approval. Once approved, a purchase order is created and you are told the result.",
    "tags": [
      "purchase",
      "approval"
    ]
  },
  "inputSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "purpose",
      "costCenter",
      "amount"
    ],
    "properties": {
      "title": {
        "type": "string",
        "title": "What are you buying?",
        "description": "A short name for the purchase, for example 'Replacement laptop'.",
        "minLength": 1,
        "maxLength": 120
      },
      "purpose": {
        "type": "string",
        "title": "Business purpose",
        "description": "Why the purchase is needed. Approvers read this first.",
        "minLength": 1,
        "maxLength": 1000
      },
      "costCenter": {
        "type": "string",
        "title": "Cost center",
        "enum": [
          "OPS",
          "IT",
          "HR"
        ]
      },
      "amount": {
        "type": "number",
        "title": "Amount (USD)",
        "description": "Total including tax and shipping.",
        "minimum": 0.01,
        "maximum": 1000000,
        "multipleOf": 0.01
      }
    }
  },
  "inputUi": {
    "order": [
      "title",
      "purpose",
      "costCenter",
      "amount"
    ],
    "widgets": {
      "purpose": "textarea",
      "costCenter": "select",
      "amount": "money"
    },
    "currency": "USD"
  },
  "outputSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "procurementId": {
        "type": "string",
        "title": "Purchase order ID"
      }
    }
  },
  "triggers": [
    "manual",
    "api"
  ],
  "nodes": [
    {
      "id": "start",
      "type": "start",
      "label": "Request submitted",
      "config": {}
    },
    {
      "id": "manager",
      "type": "approval",
      "label": "Review request",
      "config": {
        "candidateGroupRef": "managers",
        "rejectReasonRequired": true,
        "dueAfterHours": 24
      }
    },
    {
      "id": "amountPolicy",
      "type": "decision",
      "label": "Check purchase amount",
      "config": {
        "decisionRef": "amount-policy"
      }
    },
    {
      "id": "route",
      "type": "branch",
      "label": "Finance review needed?",
      "config": {}
    },
    {
      "id": "finance",
      "type": "approval",
      "label": "Finance review",
      "config": {
        "candidateGroupRef": "finance-approvers",
        "rejectReasonRequired": true,
        "dueAfterHours": 48
      }
    },
    {
      "id": "procure",
      "type": "http",
      "label": "Create purchase order",
      "config": {
        "connectionRef": "procurement",
        "operation": "createOrder",
        "inputMapping": {
          "title": "/input/title",
          "amount": "/input/amount",
          "costCenter": "/input/costCenter"
        },
        "resultMapping": {
          "procurementId": "/id"
        },
        "timeoutSeconds": 20
      }
    },
    {
      "id": "notify",
      "type": "notification",
      "label": "Tell requester it is ordered",
      "config": {
        "channel": "inApp",
        "recipient": "initiator",
        "message": "Your purchase request was approved and the purchase order has been created."
      }
    },
    {
      "id": "fulfilled",
      "type": "end",
      "label": "Fulfilled",
      "config": {
        "businessOutcome": "Fulfilled",
        "outcomeKind": "success"
      }
    },
    {
      "id": "notifyRejected",
      "type": "notification",
      "label": "Tell requester it was rejected",
      "config": {
        "channel": "inApp",
        "recipient": "initiator",
        "message": "Your purchase request was rejected. Open the request to see the reason."
      }
    },
    {
      "id": "rejected",
      "type": "end",
      "label": "Rejected",
      "config": {
        "businessOutcome": "Rejected",
        "outcomeKind": "rejected"
      }
    }
  ],
  "transitions": [
    {
      "id": "t1",
      "from": "start",
      "to": "manager",
      "on": "next"
    },
    {
      "id": "t2",
      "from": "manager",
      "to": "amountPolicy",
      "on": "approved"
    },
    {
      "id": "t3",
      "from": "manager",
      "to": "notifyRejected",
      "on": "rejected"
    },
    {
      "id": "t4",
      "from": "amountPolicy",
      "to": "route",
      "on": "next"
    },
    {
      "id": "t5",
      "from": "route",
      "to": "finance",
      "on": "condition",
      "label": "USD 5,000 or more",
      "condition": {
        "fieldRef": "/steps/amountPolicy/route",
        "operator": "eq",
        "value": "financeReview"
      }
    },
    {
      "id": "t6",
      "from": "route",
      "to": "procure",
      "on": "default",
      "label": "Under USD 5,000"
    },
    {
      "id": "t7",
      "from": "finance",
      "to": "procure",
      "on": "approved"
    },
    {
      "id": "t8",
      "from": "finance",
      "to": "notifyRejected",
      "on": "rejected"
    },
    {
      "id": "t9",
      "from": "procure",
      "to": "notify",
      "on": "next"
    },
    {
      "id": "t10",
      "from": "notify",
      "to": "fulfilled",
      "on": "next"
    },
    {
      "id": "t11",
      "from": "notifyRejected",
      "to": "rejected",
      "on": "next"
    }
  ],
  "decisions": [
    {
      "key": "amount-policy",
      "version": 1,
      "hitPolicy": "UNIQUE",
      "rows": [
        {
          "when": {
            "fieldRef": "/input/amount",
            "operator": "gte",
            "value": 5000
          },
          "then": {
            "route": "financeReview"
          }
        }
      ],
      "default": {
        "route": "standard"
      }
    }
  ],
  "execution": {
    "maxConcurrentRuns": 500,
    "maxAttempts": 3,
    "retryDelaySeconds": 30
  },
  "security": {
    "selfApproval": "deny"
  },
  "dependencies": {
    "connections": [
      {
        "key": "procurement",
        "definitionVersion": 1
      }
    ]
  },
  "outputMapping": {
    "procurementId": {
      "fieldRef": "/steps/procure/procurementId",
      "required": false
    }
  },
  "uiLayout": {
    "positions": {
      "start": {
        "x": 80,
        "y": 200
      },
      "manager": {
        "x": 300,
        "y": 200
      },
      "amountPolicy": {
        "x": 540,
        "y": 200
      },
      "route": {
        "x": 780,
        "y": 200
      },
      "finance": {
        "x": 1000,
        "y": 60
      },
      "procure": {
        "x": 1220,
        "y": 200
      },
      "notify": {
        "x": 1440,
        "y": 200
      },
      "fulfilled": {
        "x": 1660,
        "y": 200
      },
      "notifyRejected": {
        "x": 780,
        "y": 420
      },
      "rejected": {
        "x": 1000,
        "y": 420
      }
    },
    "viewport": {
      "x": 0,
      "y": 0,
      "zoom": 0.8
    }
  }
}
