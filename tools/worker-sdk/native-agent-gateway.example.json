{
  "orqix": {
    "base_url": "https://orqix.example/api/v1",
    "workspace_id": "00000000-0000-4000-8000-000000000001",
    "token_file": "/var/run/secrets/orqix-worker-token",
    "worker_id": "native-agent-gateway-1"
  },
  "profiles": {
    "native-mcp": {
      "protocol": "mcp-2025-11-25",
      "endpoint": "https://tools.example/mcp",
      "token_file": "/var/run/secrets/tool-provider-token",
      "tool": "lookup",
      "result_mapping": { "score": "/score" },
      "timeout_seconds": 3600,
      "poll_seconds": 5
    },
    "native-a2a": {
      "protocol": "a2a-1.0",
      "endpoint": "https://agent.example/rpc",
      "token_file": "/var/run/secrets/a2a-provider-token",
      "result_mapping": { "score": "/score" }
    },
    "native-model": {
      "protocol": "responses-v1",
      "endpoint": "https://api.openai.com/v1/responses",
      "token_file": "/var/run/secrets/model-provider-token",
      "model": "YOUR_BACKGROUND_CAPABLE_MODEL",
      "instructions": "Assess the supplied question. Return a JSON object containing score as a number from 0 to 10.",
      "max_output_tokens": 1024,
      "result_mapping": { "score": "/score" }
    }
  }
}
